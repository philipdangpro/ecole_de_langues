SQL> @@05_normalisation.sql
SQL> -- =====================================================================
SQL> -- 05_normalisation.sql
SQL> -- Livrable : L3 · Normalisation
SQL> -- Responsable : Younes (analyse de départ, en Python), Baptiste (reprise en SQL)
SQL> -- Attendu  : table des opérations à plat + dépendances fonctionnelles + décomposition
SQL> --            + dénormalisation assumée. Explications : docs/L3_normalisation/L3_normalisation.md
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Plan :
SQL> --   1. OPERATION_A_PLAT : une ligne par opération du CSV, avec son étudiant, sa session et
SQL> --      les deux campus (celui de l'étudiant, celui de la session). Construite depuis les
SQL> --      CSV bruts (tables externes du L2), donc AVANT tout nettoyage.
SQL> --   2. Dépendances fonctionnelles (DF) vérifiées sur cette table, une requête par DF.
SQL> --   3. Décomposition : on projette la table à plat en 4 relations, on les rejoint, et on
SQL> --      vérifie qu'on retrouve exactement la table à plat (décomposition sans perte).
SQL> --   4. Dénormalisation assumée : le site de la session est recopié dans INSCRIPTION
SQL> --      (colonne id_site), tenu cohérent par une clé étrangère composite et un trigger.
SQL> --
SQL> -- Lit les tables externes EXT_* et les tables du L1/L2 : à lancer après 02_chargement.sql.
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Table des opérations à plat
SQL> --    Mêmes conversions qu'en 02_chargement.sql (format explicite, point décimal imposé).
SQL> --    LEFT JOIN : les 220 opérations dont la session n'existe pas sont gardées, avec des
SQL> --    colonnes de session vides. Rien n'est corrigé : l'e-mail est gardé tel qu'il est
SQL> --    dans le CSV (majuscules, espaces), les copies d'étudiants gardent leur propre id.
SQL> --    Le téléphone reste du texte : il garde son 0 initial.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE operation_a_plat AS
  2  WITH ins AS (
  3      SELECT TO_NUMBER(id_inscription)                                 AS id_inscription,
  4             TO_NUMBER(id_etudiant)                                    AS id_etudiant,
  5             TO_NUMBER(id_session)                                     AS id_session,
  6             TRIM(id_groupe)                                           AS id_groupe,
  7             TO_DATE(TRIM(date_inscription), 'YYYY-MM-DD HH24:MI:SS')  AS date_operation,
  8             TO_NUMBER(nb_places)                                      AS nb_places,
  9             TO_NUMBER(montant, '999999D99', 'NLS_NUMERIC_CHARACTERS=''.,''') AS montant,
 10             TRIM(statut)                                              AS statut
 11      FROM   ext_inscriptions
 12  ), etu AS (
 13      SELECT TO_NUMBER(id_etudiant)                         AS id_etudiant,
 14             TRIM(nom)                                      AS nom,
 15             TRIM(prenom)                                   AS prenom,
 16             email,                                         -- brut, tel que dans le CSV
 17             TRIM(telephone)                                AS telephone,
 18             TRIM(ville)                                    AS ville,
 19             TO_NUMBER(id_campus)                           AS id_campus,
 20             TO_DATE(TRIM(date_inscription), 'YYYY-MM-DD')  AS date_creation_compte
 21      FROM   ext_etudiants
 22  ), ses AS (
 23      SELECT TO_NUMBER(id_session)                               AS id_session,
 24             TRIM(libelle)                                       AS libelle,
 25             TRIM(categorie)                                     AS categorie,
 26             TO_NUMBER(id_campus)                                AS id_campus,
 27             TO_DATE(TRIM(debut), 'YYYY-MM-DD HH24:MI:SS')       AS debut,
 28             TO_NUMBER(duree_minutes)                            AS duree_minutes,
 29             TO_NUMBER(capacite)                                 AS capacite,
 30             TO_NUMBER(prix_unitaire, '999999D99', 'NLS_NUMERIC_CHARACTERS=''.,''') AS prix_unitaire
 31      FROM   ext_sessions
 32  ), cam AS (
 33      SELECT TO_NUMBER(id_campus) AS id_campus, TRIM(nom) AS nom, TRIM(ville) AS ville,
 34             TRIM(role) AS role
 35      FROM   ext_campus
 36  )
 37  SELECT -- l'opération
 38         i.id_inscription, i.id_etudiant, i.id_session, i.id_groupe, i.date_operation,
 39         i.nb_places, i.montant, i.statut,
 40         -- l'usager
 41         e.nom, e.prenom, e.email, e.telephone, e.ville,
 42         e.id_campus  AS id_campus_etudiant, e.date_creation_compte,
 43         ce.nom       AS nom_campus_etudiant, ce.ville AS ville_campus_etudiant,
 44         ce.role      AS role_campus_etudiant,
 45         -- la ressource
 46         s.libelle    AS libelle_session, s.categorie, s.id_campus AS id_campus_session,
 47         s.debut, s.duree_minutes, s.capacite, s.prix_unitaire,
 48         cs.nom       AS nom_campus_session, cs.ville AS ville_campus_session,
 49         cs.role      AS role_campus_session
 50  FROM   ins i
 51  LEFT JOIN etu e  ON e.id_etudiant  = i.id_etudiant
 52  LEFT JOIN cam ce ON ce.id_campus   = e.id_campus
 53  LEFT JOIN ses s  ON s.id_session   = i.id_session
 54  LEFT JOIN cam cs ON cs.id_campus   = s.id_campus;

Table OPERATION_A_PLAT créé(e).

SQL> 
SQL> -- La clé de la table à plat est id_inscription (la contrainte le prouve : elle serait
SQL> -- refusée s'il y avait un doublon).
SQL> ALTER TABLE operation_a_plat ADD CONSTRAINT pk_operation_a_plat PRIMARY KEY (id_inscription);

Table OPERATION_A_PLAT modifié(e).

SQL> 
SQL> COMMENT ON TABLE operation_a_plat IS 'L3 : opérations du CSV à plat (inscription + étudiant + session + campus), avant nettoyage. Sert à vérifier les DF.';

Comment créé(e).

SQL> 
SQL> SELECT COUNT(*) AS lignes_a_plat FROM operation_a_plat;

LIGNES_A_PLAT
-------------
       354855

SQL> -- Résultat : 354 855 lignes, 28 colonnes
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Dépendances fonctionnelles
SQL> --    Méthode : X -> Y tient si chaque valeur de X n'apparaît qu'avec une seule valeur de Y.
SQL> --    On prend les couples (X, Y) distincts, on regroupe par X, et on compte les X qui ont
SQL> --    plus d'un Y. Ce nombre est la colonne « violations » : 0 = la DF tient sur les données.
SQL> --    (SELECT DISTINCT traite deux NULL comme égaux, contrairement à COUNT(DISTINCT) :
SQL> --    une valeur vide face à une valeur remplie compte bien comme une violation.)
SQL> --    Une DF qui tient sur les données n'est retenue que si une règle métier la justifie.
SQL> -- ---------------------------------------------------------------------
SQL> COLUMN n          FORMAT A3
SQL> COLUMN dependance FORMAT A75
SQL> COLUMN conclusion FORMAT A60
SQL> 
SQL> -- 2a. Dépendances retenues, et celles que les défauts du CSV violent
SQL> SELECT 'D1' AS n, 'id_inscription -> toutes les colonnes' AS dependance,
  2         COUNT(*) AS violations, 'tient : clé de la table à plat' AS conclusion
  3  FROM  (SELECT id_inscription FROM operation_a_plat GROUP BY id_inscription HAVING COUNT(*) > 1)
  4  UNION ALL
  5  SELECT 'D2', 'id_etudiant -> nom, prenom, email, telephone, ville, id_campus_etudiant, date_creation_compte',
  6         COUNT(*), 'tient : relation ETUDIANT'
  7  FROM  (SELECT id_etudiant
  8         FROM  (SELECT DISTINCT id_etudiant, nom, prenom, email, telephone, ville,
  9                                id_campus_etudiant, date_creation_compte FROM operation_a_plat)
 10         GROUP BY id_etudiant HAVING COUNT(*) > 1)
 11  UNION ALL
 12  SELECT 'D3', 'id_session -> libelle, categorie, id_campus_session, debut, duree, capacite, prix',
 13         COUNT(*), 'tient : relation SESSION'
 14  FROM  (SELECT id_session
 15         FROM  (SELECT DISTINCT id_session, libelle_session, categorie, id_campus_session, debut,
 16                                duree_minutes, capacite, prix_unitaire FROM operation_a_plat)
 17         GROUP BY id_session HAVING COUNT(*) > 1)
 18  UNION ALL
 19  SELECT 'D4', 'id_campus -> nom, ville, role (campus de l''étudiant et de la session)',
 20         COUNT(*), 'tient : relation CAMPUS (une seule pour les deux rôles)'
 21  FROM  (SELECT id_campus
 22         FROM  (SELECT id_campus_etudiant AS id_campus, nom_campus_etudiant AS nom,
 23                       ville_campus_etudiant AS ville, role_campus_etudiant AS role
 24                FROM operation_a_plat
 25                UNION                                   -- UNION enlève déjà les doublons
 26                SELECT id_campus_session, nom_campus_session, ville_campus_session, role_campus_session
 27                FROM operation_a_plat WHERE id_campus_session IS NOT NULL)
 28         GROUP BY id_campus HAVING COUNT(*) > 1)
 29  UNION ALL
 30  SELECT 'D5', 'libelle_session -> id_session',
 31         COUNT(*), 'tient : le libellé est une 2e clé de SESSION'
 32  FROM  (SELECT libelle_session
 33         FROM  (SELECT DISTINCT libelle_session, id_session FROM operation_a_plat
 34                WHERE libelle_session IS NOT NULL)
 35         GROUP BY libelle_session HAVING COUNT(*) > 1)
 36  UNION ALL
 37  SELECT 'D6', 'email normalisé (minuscules, sans espaces) -> id_etudiant',
 38         COUNT(*), 'violée par les 73 copies : fusion au L2 (RG4)'
 39  FROM  (SELECT LOWER(REPLACE(email, ' ', ''))
 40         FROM  (SELECT DISTINCT email, id_etudiant FROM operation_a_plat WHERE email IS NOT NULL)
 41         GROUP BY LOWER(REPLACE(email, ' ', '')) HAVING COUNT(DISTINCT id_etudiant) > 1)
 42  UNION ALL
 43  SELECT 'D7', 'id_session, nb_places -> montant',
 44         COUNT(*), 'violée par des opérations non valides (rejetées au L2)'
 45  FROM  (SELECT id_session, nb_places
 46         FROM  (SELECT DISTINCT id_session, nb_places, montant FROM operation_a_plat)
 47         GROUP BY id_session, nb_places HAVING COUNT(*) > 1)
 48  UNION ALL
 49  SELECT 'D8', 'id_groupe -> id_etudiant',
 50         COUNT(*), 'violée par des copies d''étudiants : tient après fusion'
 51  FROM  (SELECT id_groupe
 52         FROM  (SELECT DISTINCT id_groupe, id_etudiant FROM operation_a_plat
 53                WHERE id_groupe IS NOT NULL)
 54         GROUP BY id_groupe HAVING COUNT(*) > 1)
 55  UNION ALL
 56  SELECT 'D9', 'id_groupe -> statut',
 57         COUNT(*), 'tient : un parcours est confirmé ou annulé en entier'
 58  FROM  (SELECT id_groupe
 59         FROM  (SELECT DISTINCT id_groupe, statut FROM operation_a_plat WHERE id_groupe IS NOT NULL)
 60         GROUP BY id_groupe HAVING COUNT(*) > 1)
 61  ORDER BY 1;

N   DEPENDANCE                                                                  VIOLATIONS CONCLUSION                                                  
--- --------------------------------------------------------------------------- ---------- ------------------------------------------------------------
D1  id_inscription -> toutes les colonnes                                                0 tient : clé de la table à plat                              
D2  id_etudiant -> nom, prenom, email, telephone, ville, id_campus_etudiant, da          0 tient : relation ETUDIANT                                   
    te_creation_compte                                                                                                                                 

D3  id_session -> libelle, categorie, id_campus_session, debut, duree, capacite          0 tient : relation SESSION                                    
    , prix                                                                                                                                             

D4  id_campus -> nom, ville, role (campus de l'étudiant et de la session)                0 tient : relation CAMPUS (une seule pour les deux rôles)     
D5  libelle_session -> id_session                                                        0 tient : le libellé est une 2e clé de SESSION                
D6  email normalisé (minuscules, sans espaces) -> id_etudiant                           73 violée par les 73 copies : fusion au L2 (RG4)               
D7  id_session, nb_places -> montant                                                    88 violée par des opérations non valides (rejetées au L2)      

N   DEPENDANCE                                                                  VIOLATIONS CONCLUSION                                                  
--- --------------------------------------------------------------------------- ---------- ------------------------------------------------------------
D8  id_groupe -> id_etudiant                                                             9 violée par des copies d'étudiants : tient après fusion      
D9  id_groupe -> statut                                                                  0 tient : un parcours est confirmé ou annulé en entier        

9 lignes sélectionnées. 

SQL> -- Résultat :
SQL> --   D1  0      D2  0      D3  0      D4  0      D5  0
SQL> --   D6  73     D7  88     D8  9      D9  0
SQL> --   D6 : les 73 copies d'étudiants (même e-mail une fois normalisé, id différent).
SQL> --   D7 : 80 sessions où un montant négatif côtoie le bon montant (le négatif vaut
SQL> --        exactement -nb_places x prix), + 8 id de session inexistants vus avec plusieurs
SQL> --        montants. Ce sont les opérations non valides du sujet.
SQL> --   D8 : 9 parcours passés en partie sous l'id d'une copie : même personne, deux id.
SQL> 
SQL> -- 2b. Les mêmes DF après le chargement du L2 (tables nettoyées) : plus aucune violation
SQL> SELECT 'D6' AS n, 'email -> id_etudiant (ETUDIANT)' AS dependance, COUNT(*) AS violations
  2  FROM  (SELECT email FROM etudiant WHERE email IS NOT NULL GROUP BY email HAVING COUNT(*) > 1)
  3  UNION ALL
  4  SELECT 'D7', 'id_session, nb_places -> montant (INSCRIPTION)', COUNT(*)
  5  FROM  (SELECT id_session, nb_places FROM inscription
  6         GROUP BY id_session, nb_places HAVING COUNT(DISTINCT montant) > 1)
  7  UNION ALL
  8  SELECT 'D7b', 'montant = nb_places x prix_unitaire (INSCRIPTION, RG12)', COUNT(*)
  9  FROM   inscription i JOIN session_cours s ON s.id_session = i.id_session
 10  WHERE  i.montant <> i.nb_places * s.prix_unitaire
 11  UNION ALL
 12  SELECT 'D8', 'id_groupe -> id_etudiant (INSCRIPTION)', COUNT(*)
 13  FROM  (SELECT id_groupe FROM inscription WHERE id_groupe IS NOT NULL
 14         GROUP BY id_groupe HAVING COUNT(DISTINCT id_etudiant) > 1)
 15  ORDER BY 1;

N   DEPENDANCE                                                                  VIOLATIONS
--- --------------------------------------------------------------------------- ----------
D6  email -> id_etudiant (ETUDIANT)                                                      0
D7  id_session, nb_places -> montant (INSCRIPTION)                                       0
D7b montant = nb_places x prix_unitaire (INSCRIPTION, RG12)                              0
D8  id_groupe -> id_etudiant (INSCRIPTION)                                               0

SQL> -- Résultat : 0 partout. D7b : le montant se recalcule toujours à partir de la session
SQL> -- (c'est la redondance discutée dans la doc, partie dénormalisation).
SQL> 
SQL> -- 2c. Dépendances qu'on pourrait croire vraies, et qu'on ne retient pas
SQL> SELECT 'N1' AS n, 'id_etudiant -> id_campus_session' AS dependance,
  2         COUNT(*) AS violations, 'fausse : un étudiant suit des cours sur plusieurs sites' AS conclusion
  3  FROM  (SELECT id_etudiant
  4         FROM  (SELECT DISTINCT id_etudiant, id_campus_session FROM operation_a_plat
  5                WHERE id_campus_session IS NOT NULL)
  6         GROUP BY id_etudiant HAVING COUNT(*) > 1)
  7  UNION ALL
  8  SELECT 'N2', 'telephone -> id_etudiant', COUNT(*), 'fausse : le téléphone n''identifie personne'
  9  FROM  (SELECT telephone
 10         FROM  (SELECT DISTINCT telephone, id_etudiant FROM operation_a_plat WHERE telephone IS NOT NULL)
 11         GROUP BY telephone HAVING COUNT(*) > 1)
 12  UNION ALL
 13  SELECT 'N3', 'categorie -> prix_unitaire', COUNT(*), 'fausse : le prix est fixé session par session'
 14  FROM  (SELECT categorie
 15         FROM  (SELECT DISTINCT categorie, prix_unitaire FROM operation_a_plat WHERE categorie IS NOT NULL)
 16         GROUP BY categorie HAVING COUNT(*) > 1)
 17  UNION ALL
 18  SELECT 'N4', 'ville (de l''étudiant) -> id_campus_etudiant', COUNT(*),
 19         'tient dans les données, pas une règle : non retenue'
 20  FROM  (SELECT ville
 21         FROM  (SELECT DISTINCT ville, id_campus_etudiant FROM operation_a_plat)
 22         GROUP BY ville HAVING COUNT(*) > 1)
 23  ORDER BY 1;

N   DEPENDANCE                                                                  VIOLATIONS CONCLUSION                                                  
--- --------------------------------------------------------------------------- ---------- ------------------------------------------------------------
N1  id_etudiant -> id_campus_session                                                 12369 fausse : un étudiant suit des cours sur plusieurs sites     
N2  telephone -> id_etudiant                                                            75 fausse : le téléphone n'identifie personne                  
N3  categorie -> prix_unitaire                                                           6 fausse : le prix est fixé session par session               
N4  ville (de l'étudiant) -> id_campus_etudiant                                          0 tient dans les données, pas une règle : non retenue         

SQL> -- Résultat : N1 12 369, N2 75, N3 6, N4 0
SQL> --   N2 : 73 téléphones partagés par une copie et son original, 2 par deux vraies personnes.
SQL> --   N4 : coïncidence du jeu de données (chaque étudiant habite la ville de son campus) ;
SQL> --        aucune règle ne l'impose, un étudiant peut habiter ailleurs. Non retenue.
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. Décomposition et vérification « sans perte »
SQL> --    Chaque DF retenue (D2 à D4) donne une relation dont le déterminant est la clé.
SQL> --    On projette la table à plat sur ces relations (SELECT DISTINCT), on les rejoint
SQL> --    par leurs clés, et on compare avec la table à plat dans les deux sens (MINUS).
SQL> --    0 ligne dans les deux sens = la décomposition ne perd et n'invente aucune ligne.
SQL> --    Les tables du L1 sont ces relations, après nettoyage (L2), avec en plus :
SQL> --    CATEGORIE (liste des langues) et l'héritage SIEGE / SITE.
SQL> -- ---------------------------------------------------------------------
SQL> WITH r_inscription AS (
  2      SELECT DISTINCT id_inscription, id_etudiant, id_session, id_groupe, date_operation,
  3                      nb_places, montant, statut
  4      FROM   operation_a_plat
  5  ), r_etudiant AS (
  6      SELECT DISTINCT id_etudiant, nom, prenom, email, telephone, ville,
  7                      id_campus_etudiant AS id_campus, date_creation_compte
  8      FROM   operation_a_plat
  9  ), r_session AS (
 10      SELECT DISTINCT id_session, libelle_session, categorie, id_campus_session AS id_campus,
 11                      debut, duree_minutes, capacite, prix_unitaire
 12      FROM   operation_a_plat
 13      WHERE  libelle_session IS NOT NULL               -- les 220 sessions inexistantes n'en font pas partie
 14  ), r_campus AS (
 15      SELECT id_campus_etudiant AS id_campus, nom_campus_etudiant AS nom,
 16             ville_campus_etudiant AS ville, role_campus_etudiant AS role
 17      FROM   operation_a_plat
 18      UNION
 19      SELECT id_campus_session, nom_campus_session, ville_campus_session, role_campus_session
 20      FROM   operation_a_plat WHERE id_campus_session IS NOT NULL
 21  ), rejointure AS (
 22      SELECT i.id_inscription, i.id_etudiant, i.id_session, i.id_groupe, i.date_operation,
 23             i.nb_places, i.montant, i.statut,
 24             e.nom, e.prenom, e.email, e.telephone, e.ville,
 25             e.id_campus  AS id_campus_etudiant, e.date_creation_compte,
 26             ce.nom       AS nom_campus_etudiant, ce.ville AS ville_campus_etudiant,
 27             ce.role      AS role_campus_etudiant,
 28             s.libelle_session, s.categorie, s.id_campus AS id_campus_session, s.debut,
 29             s.duree_minutes, s.capacite, s.prix_unitaire,
 30             cs.nom       AS nom_campus_session, cs.ville AS ville_campus_session,
 31             cs.role      AS role_campus_session
 32      FROM   r_inscription i
 33      JOIN   r_etudiant    e  ON e.id_etudiant = i.id_etudiant
 34      JOIN   r_campus      ce ON ce.id_campus  = e.id_campus
 35      LEFT JOIN r_session  s  ON s.id_session  = i.id_session      -- LEFT : sessions inexistantes
 36      LEFT JOIN r_campus   cs ON cs.id_campus  = s.id_campus
 37  )
 38  SELECT (SELECT COUNT(*) FROM r_inscription) AS nb_inscription,
 39         (SELECT COUNT(*) FROM r_etudiant)    AS nb_etudiant,
 40         (SELECT COUNT(*) FROM r_session)     AS nb_session,
 41         (SELECT COUNT(*) FROM r_campus)      AS nb_campus,
 42         (SELECT COUNT(*) FROM (SELECT * FROM rejointure MINUS SELECT * FROM operation_a_plat))
 43                                              AS lignes_inventees,
 44         (SELECT COUNT(*) FROM (SELECT * FROM operation_a_plat MINUS SELECT * FROM rejointure))
 45                                              AS lignes_perdues
 46  FROM dual;

NB_INSCRIPTION NB_ETUDIANT NB_SESSION  NB_CAMPUS LIGNES_INVENTEES LIGNES_PERDUES
-------------- ----------- ---------- ---------- ---------------- --------------
        354855       21544      47619          3                0              0

SQL> -- Résultat : 354 855 inscriptions, 21 544 étudiants, 47 619 sessions, 3 campus,
SQL> --            0 ligne inventée, 0 ligne perdue
SQL> --   3 campus et non 4 : le siège n'a ni étudiant ni session, il n'apparaît donc dans
SQL> --   aucune opération. C'est l'anomalie d'insertion de la table à plat : on ne peut pas y
SQL> --   enregistrer un campus (ou un étudiant, une session) qui n'a pas encore d'opération.
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 4. Dénormalisation assumée : le site de la session recopié dans INSCRIPTION
SQL> --    En 3NF, le site d'une opération se déduit par jointure (RG10, vue V_INSCRIPTION_SITE).
SQL> --    On le recopie dans INSCRIPTION.id_site, car C5, C6, C8 et la répartition des données
SQL> --    par site (L5, L6) en ont besoin sans passer par SESSION_COURS. Justification et
SQL> --    mesures : docs/L3_normalisation/L3_normalisation.md.
SQL> --
SQL> --    Cohérence garantie de deux façons :
SQL> --    - la clé étrangère composite (id_session, id_site) -> SESSION_COURS (id_session,
SQL> --      id_campus) refuse tout site différent de celui de la session (même principe que
SQL> --      l'héritage CAMPUS / SITE du L1) ;
SQL> --    - le trigger TRG_INSCRIPTION_SITE remplit id_site tout seul : les scripts suivants
SQL> --      (package du L4, etc.) n'ont pas à s'en occuper.
SQL> --    Conséquence : on ne peut plus changer le site d'une session qui a des inscriptions
SQL> --    (ORA-02292). C'est voulu : une session ne change pas de ville.
SQL> -- ---------------------------------------------------------------------
SQL> ALTER TABLE inscription ADD (id_site NUMBER(4));

