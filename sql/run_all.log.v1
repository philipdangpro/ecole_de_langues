SQL> @@11_bonus_objet.sql
SQL> -- =====================================================================
SQL> -- 11_bonus_objet.sql
SQL> -- Livrable : Bonus objet-relationnel
SQL> -- Responsable : Baptiste (avec Claude Code)
SQL> -- Attendu  : type objet avec héritage et méthode, utilisé dans une requête
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- On reprend l'héritage déjà présent dans le modèle (L1) : un CAMPUS est soit
SQL> -- le siège, soit un site. Ici il est écrit en types objet :
SQL> --   t_campus (type parent, NOT FINAL pour pouvoir en hériter) et sa méthode presenter()
SQL> --   t_site UNDER t_campus : hérite des attributs et de la méthode, ajoute id_siege
SQL> -- Une seule table objet de type t_campus accueille les deux (le siège en t_campus,
SQL> -- les sites en t_site), puis une requête appelle la méthode sur chaque ligne.
SQL> -- Le nettoyage (00_nettoyage.sql) supprime déjà les types (DROP TYPE ... FORCE).
SQL> -- =====================================================================
SQL> 
SQL> SET SERVEROUTPUT ON
SQL> SET LINESIZE 200
SQL> 
SQL> -- Type parent : NOT FINAL autorise l'héritage
SQL> CREATE OR REPLACE TYPE t_campus AS OBJECT (
  2      id_campus  NUMBER(4),
  3      nom        VARCHAR2(60 CHAR),
  4      ville      VARCHAR2(60 CHAR),
  5      MEMBER FUNCTION presenter RETURN VARCHAR2
  6  ) NOT FINAL;
  7  /

Elément Type T_CAMPUS compilé

SQL> 
SQL> CREATE OR REPLACE TYPE BODY t_campus AS
  2      MEMBER FUNCTION presenter RETURN VARCHAR2 IS
  3      BEGIN
  4          RETURN nom || ' (' || ville || ')';
  5      END;
  6  END;
  7  /

Elément Type Body T_CAMPUS compilé

SQL> 
SQL> -- Sous-type : un site est un campus qui dépend du siège
SQL> CREATE OR REPLACE TYPE t_site UNDER t_campus (
  2      id_siege   NUMBER(4)
  3  );
  4  /

Elément Type T_SITE compilé

SQL> 
SQL> -- Table objet : chaque ligne est un objet t_campus, ou d'un sous-type (t_site)
SQL> CREATE TABLE campus_objet OF t_campus (
  2      CONSTRAINT pk_campus_objet PRIMARY KEY (id_campus)
  3  );

Table CAMPUS_OBJET créé(e).

SQL> 
SQL> -- Remplissage à partir des tables du L1
SQL> INSERT INTO campus_objet
  2  SELECT t_campus(c.id_campus, c.nom, c.ville)
  3  FROM   campus c JOIN siege g ON g.id_campus = c.id_campus;

1 ligne inséré.

SQL> 
SQL> INSERT INTO campus_objet
  2  SELECT t_site(c.id_campus, c.nom, c.ville, s.id_siege)
  3  FROM   campus c JOIN site s ON s.id_campus = c.id_campus;

3 lignes inséré.

SQL> 
SQL> COMMIT;
Validation terminée.
SQL> 
SQL> -- Requête : la méthode presenter() est appelée sur le siège comme sur les sites
SQL> -- (les sites l'ont héritée). TREAT lit l'attribut propre au sous-type t_site
SQL> -- (vide pour le siège, qui n'est pas un t_site).
SQL> COLUMN campus FORMAT A40
SQL> COLUMN type_objet FORMAT A10
SQL> SELECT c.id_campus,
  2         c.presenter()                          AS campus,
  3         CASE WHEN VALUE(c) IS OF (t_site) THEN 'T_SITE' ELSE 'T_CAMPUS' END AS type_objet,
  4         TREAT(VALUE(c) AS t_site).id_siege     AS id_siege
  5  FROM   campus_objet c
  6  ORDER BY c.id_campus;

