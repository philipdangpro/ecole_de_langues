SQL> -- ---------------------------------------------------------------------
SQL> -- 4. Sécurité par ligne (VPD)
SQL> --    La fonction renvoie la condition qu'Oracle ajoute aux requêtes du compte connecté :
SQL> --      - langues (propriétaire) : aucune condition. Indispensable : les triggers et le
SQL> --        package du L4, la vue matérialisée du L5 tournent sous ce compte ;
SQL> --      - compte rattaché à un site : id_site = ce site ;
SQL> --      - compte « tous les sites » (direction) : aucune condition ;
SQL> --      - tout autre compte : 1 = 0, il ne voit rien (refus par défaut).
SQL> --    La politique est posée sur les TABLES, pas sur les vues : elle s'applique quel que
SQL> --    soit le chemin (vue, jointure, sous-requête).
SQL> --    Pas de politique sur ETUDIANT : un étudiant de Bordeaux peut suivre un cours à Tours
SQL> --    (12 356 personnes ont des opérations sur au moins deux sites, C6). L'agent de Tours
SQL> --    doit le voir dans la liste de SA session. Il ne voit les étudiants qu'à travers
SQL> --    v_inscrits_site, donc seulement ceux inscrits dans son site.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE FUNCTION fn_vpd_site (p_schema IN VARCHAR2, p_objet IN VARCHAR2)
  2  RETURN VARCHAR2
  3  IS
  4      v_compte  VARCHAR2(128) := SYS_CONTEXT('USERENV', 'SESSION_USER');
  5      v_trouve  NUMBER;
  6      v_site    compte_site.id_site%TYPE;
  7      v_colonne VARCHAR2(30);
  8  BEGIN
  9      IF v_compte = p_schema THEN
 10          RETURN NULL;
 11      END IF;
 12  
 13      SELECT COUNT(*), MAX(id_site) INTO v_trouve, v_site
 14      FROM   compte_site
 15      WHERE  nom_compte = v_compte;
 16  
 17      IF v_trouve = 0 THEN
 18          RETURN '1 = 0';
 19      ELSIF v_site IS NULL THEN
 20          RETURN NULL;
 21      END IF;
 22  
 23      -- le site s'appelle id_site dans INSCRIPTION, id_campus dans SESSION_COURS
 24      v_colonne := CASE p_objet WHEN 'INSCRIPTION' THEN 'id_site' ELSE 'id_campus' END;
 25      RETURN v_colonne || ' = ' || v_site;
 26  END fn_vpd_site;
 27  /

Elément Function FN_VPD_SITE compilé

