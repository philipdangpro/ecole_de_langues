SQL> -- Résultat : 10/09/2026, 16 068 opérations
SQL> --   Pas d'égalité : le jour suivant au classement en a 552. Le pic vient du CSV
SQL> --   (16 082 lignes ce jour-là, dont 14 non valides), heures réparties sur toute la journée.
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- C7 : nombre de sessions en sur-réservation
SQL> --    Pour chaque session : somme des places des inscriptions confirmées, comparée à sa
SQL> --    capacité (HAVING filtre après le regroupement). On compte ensuite ces sessions.
SQL> --    SUM(nb_places) et pas COUNT(*) : une inscription peut réserver plusieurs places
SQL> --    (dans ce jeu de données elles valent toutes 1, d'où le même résultat).
SQL> -- ---------------------------------------------------------------------
SQL> SELECT COUNT(*) AS c7
  2  FROM (
  3      SELECT i.id_session
  4      FROM inscription i
  5      JOIN session_cours s ON i.id_session = s.id_session
  6      WHERE i.statut = 'CONFIRMEE'
  7      GROUP BY i.id_session, s.capacite
  8      HAVING SUM(i.nb_places) > s.capacite
  9  );

        C7
----------
        15

SQL> -- Résultat : 15 sessions (même chiffre avec la vue V_SESSION_OCCUPATION du L1)
