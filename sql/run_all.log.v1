SQL> -- Résultat : voir preuves/L5_performance.txt et docs/comptes_rendus/05_L5_performance_securite.md
SQL> @@09_securite.sql
SQL> -- =====================================================================
SQL> -- 09_securite.sql
SQL> -- Livrable : L5 · Sécurité
SQL> -- Responsable : Baptiste (avec Claude Code)
SQL> -- Attendu  : rôle, vue de restriction sans données perso inutiles, VPD/masquage/audit unifié + preuve par compte
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Qui voit quoi :
SQL> --   compte          rôle              vue                 lignes vues              données personnelles
SQL> --   agent_bordeaux  role_agent_site   v_inscrits_site     site de Bordeaux (2)     nom, prénom, téléphone
SQL> --   agent_tours     role_agent_site   v_inscrits_site     site de Tours (3)        nom, prénom, téléphone
SQL> --   direction       role_direction    v_activite_site     les 3 sites              aucune
SQL> --   langues         (propriétaire)    tout                tout                     tout
SQL> --   Personne d'autre que langues ne lit les tables : ni e-mail, ni ville, ni date de
SQL> --   création du compte, ni parrain ne sortent du schéma.
SQL> --
SQL> -- Mécanisme : sécurité par ligne (VPD, package DBMS_RLS). Oracle ajoute tout seul une
SQL> -- condition « id_site = ... » à chaque requête qui touche INSCRIPTION ou SESSION_COURS,
SQL> -- selon le compte connecté. La même vue v_inscrits_site montre donc des lignes différentes
SQL> -- à agent_bordeaux et à agent_tours.
SQL> --
SQL> -- Prérequis (installation_system.sql, en system) : CREATE ROLE, DB_DEVELOPER_ROLE
SQL> -- (pour DBMS_RLS), et les comptes agent_bordeaux, agent_tours, direction.
SQL> -- Preuve de ce que voit chaque compte : preuves/L5_securite.sql et .txt
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Quel compte travaille pour quel site
SQL> --    id_site vide = tous les sites (la direction). Un compte absent de la table ne voit rien.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE compte_site (
  2      nom_compte  VARCHAR2(128 CHAR) CONSTRAINT nn_compte_site_nom NOT NULL,
  3      id_site     NUMBER(4),
  4      CONSTRAINT pk_compte_site      PRIMARY KEY (nom_compte),
  5      CONSTRAINT fk_compte_site_site FOREIGN KEY (id_site) REFERENCES site (id_campus),
  6      CONSTRAINT ck_compte_site_nom  CHECK (nom_compte = UPPER(nom_compte))
  7  );

Table COMPTE_SITE créé(e).

SQL> 
SQL> COMMENT ON TABLE compte_site IS 'L5 : site de rattachement de chaque compte Oracle, lu par la politique VPD. id_site vide = tous les sites.';

Comment créé(e).

SQL> 
SQL> INSERT INTO compte_site (nom_compte, id_site) VALUES ('AGENT_BORDEAUX', 2);

1 ligne inséré.

SQL> INSERT INTO compte_site (nom_compte, id_site) VALUES ('AGENT_TOURS',    3);

1 ligne inséré.

SQL> INSERT INTO compte_site (nom_compte, id_site) VALUES ('DIRECTION',      NULL);

1 ligne inséré.

SQL> COMMIT;
Validation terminée.
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Les vues de restriction
SQL> -- ---------------------------------------------------------------------
SQL> 
SQL> -- Agent d'accueil : la liste des inscrits aux sessions de son site. Il a besoin du nom
SQL> -- pour accueillir l'étudiant et du téléphone pour le prévenir d'un changement. Il n'a
SQL> -- pas besoin de l'e-mail, de la ville, de la date de création du compte, du parrain ni
SQL> -- du montant payé : ils ne sont pas dans la vue (minimisation, RGPD).
SQL> CREATE OR REPLACE VIEW v_inscrits_site AS
  2  SELECT s.id_campus     AS id_site,
  3         s.id_session,
  4         s.libelle       AS session_libelle,
  5         s.debut,
  6         i.id_inscription,
  7         e.nom,
  8         e.prenom,
  9         e.telephone,
 10         i.nb_places,
 11         i.statut
 12  FROM   inscription   i
 13  JOIN   session_cours s ON s.id_session  = i.id_session
 14  JOIN   etudiant      e ON e.id_etudiant = i.id_etudiant;

View V_INSCRITS_SITE créé(e).

SQL> 
SQL> -- Direction : l'activité de tous les sites, sans aucune donnée personnelle. Pas même
SQL> -- l'id de l'étudiant : un identifiant qui permet de suivre une personne reste une donnée
SQL> -- personnelle, et la direction n'en a pas besoin pour ses chiffres.
SQL> CREATE OR REPLACE VIEW v_activite_site AS
  2  SELECT i.id_site,
  3         c.ville                 AS ville_site,
  4         cat.libelle             AS langue,
  5         i.id_session,
  6         TRUNC(s.debut, 'MM')    AS mois_session,
  7         TRUNC(i.date_operation) AS jour_operation,
  8         i.nb_places,
  9         i.montant,
 10         i.statut,
 11         CASE WHEN i.id_groupe IS NULL THEN 'N' ELSE 'O' END AS dans_un_parcours
 12  FROM   inscription   i
 13  JOIN   session_cours s   ON s.id_session    = i.id_session
 14  JOIN   categorie     cat ON cat.id_categorie = s.id_categorie
 15  JOIN   campus        c   ON c.id_campus     = i.id_site;

View V_ACTIVITE_SITE créé(e).

SQL> 
SQL> COMMENT ON TABLE v_inscrits_site IS 'L5 : vue des agents d''accueil (role_agent_site), filtrée par site par la politique VPD.';

Comment créé(e).

SQL> COMMENT ON TABLE v_activite_site IS 'L5 : vue de la direction (role_direction), sans donnée personnelle.';

Comment créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. Les rôles
SQL> --    Les rôles ne sont pas supprimés par 00_nettoyage.sql (ce ne sont pas des objets du
SQL> --    schéma) : on les supprime ici s'ils existent, pour pouvoir relancer run_all.
SQL> --    Les droits vont aux rôles, et les rôles aux comptes : pour un nouvel agent, il suffit
SQL> --    de lui donner le rôle et d'ajouter une ligne dans COMPTE_SITE.
SQL> -- ---------------------------------------------------------------------
SQL> BEGIN
  2      -- le créateur d'un rôle le reçoit automatiquement : il apparaît dans USER_ROLE_PRIVS
  3      FOR r IN (SELECT granted_role FROM user_role_privs
  4                WHERE  granted_role IN ('ROLE_AGENT_SITE', 'ROLE_DIRECTION')) LOOP
  5          EXECUTE IMMEDIATE 'DROP ROLE ' || r.granted_role;
  6      END LOOP;
  7  END;
  8  /

Procédure PL/SQL terminée.

SQL> 
SQL> CREATE ROLE role_agent_site;

Role ROLE_AGENT_SITE créé(e).

