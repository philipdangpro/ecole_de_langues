SQL> BEGIN
  2      DBMS_RLS.ADD_POLICY(
  3          object_schema   => USER,
  4          object_name     => 'INSCRIPTION',
  5          policy_name     => 'POL_INSCRIPTION_SITE',
  6          function_schema => USER,
  7          policy_function => 'FN_VPD_SITE',
  8          statement_types => 'SELECT, INSERT, UPDATE, DELETE',
  9          update_check    => TRUE);          -- interdit aussi d'écrire une ligne d'un autre site
 10  
 11      DBMS_RLS.ADD_POLICY(
 12          object_schema   => USER,
 13          object_name     => 'SESSION_COURS',
 14          policy_name     => 'POL_SESSION_SITE',
 15          function_schema => USER,
 16          policy_function => 'FN_VPD_SITE',
 17          statement_types => 'SELECT, INSERT, UPDATE, DELETE',
 18          update_check    => TRUE);
 19  END;
 20  /

