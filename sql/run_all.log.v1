SQL> 
SQL> COLUMN requete      FORMAT A7
SQL> COLUMN optimisation FORMAT A40
SQL> SELECT a.requete, a.optimisation,
  2         a.blocs_lus AS blocs_avant, p.blocs_lus AS blocs_apres,
  3         ROUND(a.blocs_lus / NULLIF(p.blocs_lus, 0)) AS divise_par
  4  FROM   l5_mesure a
  5  JOIN   l5_mesure p ON p.requete = a.requete AND p.version = 'APRES'
  6  WHERE  a.version = 'AVANT'
  7  ORDER BY a.requete;

