SQL> COMMENT ON TABLE session_replique IS 'L6 : copie redondante des sessions d''Angers, lue pendant une panne du site (pkg_reparti.consulter_sessions), resynchronisée par pkg_reparti.synchroniser_replique (le dernier écrivain gagne).';

