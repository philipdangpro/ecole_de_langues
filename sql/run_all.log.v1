SQL> -- Plan après : MAT_VIEW REWRITE ACCESS FULL sur MV_ACTIVITE_MENSUELLE : la requête n'a
SQL> -- pas changé, Oracle lit la vue matérialisée. Même résultat qu'avant (C5 et C9 par site).
SQL> 
SQL> 
SQL> -- =====================================================================
SQL> -- Bilan : blocs lus avant / après
SQL> -- Pour chaque requête, on lit dans V$SQL_PLAN_STATISTICS_ALL la première étape du plan
SQL> -- (id = 1) : ses Buffers comptent les blocs lus par tout le plan.
SQL> -- Si la base a été reconstruite plusieurs fois, V$SQL peut garder d'anciennes versions
SQL> -- de la requête : on prend la plus récente (last_active_time).
SQL> -- =====================================================================
SQL> INSERT INTO l5_mesure (requete, version, optimisation, blocs_lus, lignes)
  2  SELECT SUBSTR(m.repere, 4, 2),
  3         SUBSTR(m.repere, 7),
  4         CASE SUBSTR(m.repere, 4, 2)
  5              WHEN 'Q1' THEN 'index ix_inscription_etudiant'
  6              WHEN 'Q2' THEN 'index couvrant ix_inscription_session'
  7              WHEN 'Q3' THEN 'vue matérialisée mv_activite_mensuelle'
  8         END,
  9         st.last_cr_buffer_gets + st.last_cu_buffer_gets,
 10         st.last_output_rows
 11  FROM  (SELECT 'L5_Q1_AVANT' AS repere FROM dual UNION ALL SELECT 'L5_Q1_APRES' FROM dual
 12         UNION ALL SELECT 'L5_Q2_AVANT' FROM dual UNION ALL SELECT 'L5_Q2_APRES' FROM dual
 13         UNION ALL SELECT 'L5_Q3_AVANT' FROM dual UNION ALL SELECT 'L5_Q3_APRES' FROM dual) m
 14  CROSS APPLY (SELECT sql_id, child_number FROM v$sql
 15               WHERE  sql_text LIKE '%' || m.repere || '%' AND sql_text NOT LIKE '%v$sql%'
 16               ORDER BY last_active_time DESC FETCH FIRST 1 ROW ONLY) q
 17  JOIN   v$sql_plan_statistics_all st ON st.sql_id = q.sql_id
 18                                     AND st.child_number = q.child_number
 19                                     AND st.id = 1;

6 lignes inséré.

SQL> COMMIT;
