SQL> -- ---------------------------------------------------------------------
SQL> -- 4. Étudiants
SQL> --    E-mail normalisé : minuscules, sans espaces ; vide -> NULL.
SQL> --    Pour chaque e-mail normalisé, l'original est le plus petit id ; les autres sont des copies.
SQL> -- ---------------------------------------------------------------------
SQL> INSERT INTO etudiant (id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription)
  2  SELECT id_etudiant, nom, prenom, email_norm, telephone, ville, id_campus, date_inscription
  3  FROM (
  4      SELECT TO_NUMBER(id_etudiant)                         AS id_etudiant,
  5             TRIM(nom)                                      AS nom,
  6             TRIM(prenom)                                   AS prenom,
  7             LOWER(REPLACE(email, ' ', ''))                 AS email_norm,
  8             TRIM(telephone)                                AS telephone,
  9             TRIM(ville)                                    AS ville,
 10             TO_NUMBER(id_campus)                           AS id_campus,
 11             TO_DATE(TRIM(date_inscription), 'YYYY-MM-DD')  AS date_inscription,
 12             -- rang dans le groupe des étudiants qui ont le même e-mail normalisé
 13             CASE WHEN LOWER(REPLACE(email, ' ', '')) IS NULL THEN 1
 14                  ELSE ROW_NUMBER() OVER (PARTITION BY LOWER(REPLACE(email, ' ', ''))
 15                                          ORDER BY TO_NUMBER(id_etudiant))
 16             END                                            AS rang
 17      FROM   ext_etudiants
 18  )
 19  WHERE rang = 1;

