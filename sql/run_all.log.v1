SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 5. Vues globales (au siège) : la reconstruction des tables par UNION ALL
SQL> --    Chaque branche répète le prédicat de son fragment (WHERE id_site = 2…). Il est
SQL> --    déjà vrai pour toutes les lignes du fragment, mais l'optimiseur du siège ne voit
SQL> --    pas les contraintes CHECK des sites : c'est ce prédicat qui lui dit quel site
SQL> --    contient quoi (étape de « localisation » d'une requête répartie). Une requête
SQL> --    « WHERE id_site = 3 » n'interroge alors que Tours, les deux autres branches sont
SQL> --    éliminées sans être lancées (FILTER NULL IS NOT NULL, preuve partie 7.6).
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE VIEW v_g_etudiant AS
  2  SELECT id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription, id_parrain
  3  FROM   etudiant@lien_bordeaux WHERE id_campus = 2
  4  UNION ALL
  5  SELECT id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription, id_parrain
  6  FROM   etudiant@lien_tours    WHERE id_campus = 3
  7  UNION ALL
  8  SELECT id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription, id_parrain
  9  FROM   etudiant@lien_angers   WHERE id_campus = 4;

View V_G_ETUDIANT créé(e).

SQL> 
SQL> CREATE OR REPLACE VIEW v_g_session AS
  2  SELECT id_session, libelle, id_categorie, id_campus, debut, duree_minutes, capacite, prix_unitaire
  3  FROM   session_cours@lien_bordeaux WHERE id_campus = 2
  4  UNION ALL
  5  SELECT id_session, libelle, id_categorie, id_campus, debut, duree_minutes, capacite, prix_unitaire
  6  FROM   session_cours@lien_tours    WHERE id_campus = 3
  7  UNION ALL
  8  SELECT id_session, libelle, id_categorie, id_campus, debut, duree_minutes, capacite, prix_unitaire
  9  FROM   session_cours@lien_angers   WHERE id_campus = 4;

View V_G_SESSION créé(e).

SQL> 
SQL> CREATE OR REPLACE VIEW v_g_inscription AS
  2  SELECT id_inscription, id_etudiant, id_session, id_groupe, date_operation, nb_places, montant, statut, id_site
  3  FROM   inscription@lien_bordeaux WHERE id_site = 2
  4  UNION ALL
  5  SELECT id_inscription, id_etudiant, id_session, id_groupe, date_operation, nb_places, montant, statut, id_site
  6  FROM   inscription@lien_tours    WHERE id_site = 3
  7  UNION ALL
  8  SELECT id_inscription, id_etudiant, id_session, id_groupe, date_operation, nb_places, montant, statut, id_site
  9  FROM   inscription@lien_angers   WHERE id_site = 4;

View V_G_INSCRIPTION créé(e).

SQL> 
SQL> -- Annuaires du siège : où se trouve chaque session et chaque étudiant (id -> site),
SQL> -- sans aucune donnée personnelle. pkg_reparti s'en sert pour choisir le bon lien sans
SQL> -- interroger les trois sites, et donc même quand l'un d'eux est en panne.
SQL> CREATE OR REPLACE VIEW v_annuaire_session AS
  2  SELECT id_session, id_campus AS id_site FROM session_cours;

View V_ANNUAIRE_SESSION créé(e).

SQL> 
SQL> CREATE OR REPLACE VIEW v_annuaire_etudiant AS
  2  SELECT id_etudiant, id_campus AS id_site FROM etudiant;

View V_ANNUAIRE_ETUDIANT créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 6. Package des opérations réparties
SQL> --    - inscrire_parcours : le parcours multi-sites (RG16) sur les fragments, tout ou rien.
SQL> --      Il écrit dans plusieurs sites en une seule transaction : au COMMIT de l'appelant,
SQL> --      Oracle fait tout seul une validation à deux phases (2PC) entre les sites. Si un
SQL> --      site est injoignable, le parcours est refusé en entier (cohérence avant
SQL> --      disponibilité, voir le classement CAP).
SQL> --    - inscrire : une inscription simple. Si le site est en panne, elle est mise en
SQL> --      attente au siège (OPERATION_EN_ATTENTE) et rejouée à la reprise.
SQL> --    - rejouer_attente : la reprise, qui revérifie la capacité au moment du rejeu.
SQL> --    - consulter_sessions : lit le catalogue d'un site ; s'il est en panne, bascule sur
SQL> --      la copie du siège (SESSION_REPLIQUE), comme CONSULTER_VOYAGES_NORD au Lab 5.
SQL> --    - synchroniser_replique : remet la copie et le site d'accord, dans les deux sens ;
SQL> --      en cas de conflit, la modification la plus récente gagne.
SQL> --    Les liens sont choisis à l'exécution (SQL dynamique) : le package reste valide même
SQL> --    quand un site est en panne.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE operation_en_attente (
  2      id_attente      NUMBER(10) GENERATED ALWAYS AS IDENTITY,
  3      id_site         NUMBER(4)          CONSTRAINT nn_attente_site     NOT NULL,
  4      id_inscription  NUMBER(10)         CONSTRAINT nn_attente_insc     NOT NULL,
  5      id_etudiant     NUMBER(8)          CONSTRAINT nn_attente_etudiant NOT NULL,
  6      id_session      NUMBER(8)          CONSTRAINT nn_attente_session  NOT NULL,
  7      nb_places       NUMBER(3)          CONSTRAINT nn_attente_places   NOT NULL,
  8      date_operation  DATE               CONSTRAINT nn_attente_date     NOT NULL,
  9      mise_en_attente DATE DEFAULT SYSDATE CONSTRAINT nn_attente_quand  NOT NULL,
 10      etat            VARCHAR2(10 CHAR) DEFAULT 'EN_ATTENTE' CONSTRAINT nn_attente_etat NOT NULL,
 11      motif           VARCHAR2(200 CHAR),
 12      CONSTRAINT pk_operation_en_attente PRIMARY KEY (id_attente),
 13      CONSTRAINT fk_attente_site  FOREIGN KEY (id_site) REFERENCES catalogue_site (id_site),
 14      CONSTRAINT ck_attente_etat  CHECK (etat IN ('EN_ATTENTE', 'REJOUEE', 'REFUSEE'))
 15  );

Table OPERATION_EN_ATTENTE créé(e).

SQL> 
SQL> COMMENT ON TABLE operation_en_attente IS 'L6 : inscriptions reçues au siège pendant la panne de leur site, rejouées à la reprise (pkg_reparti.rejouer_attente).';

Comment créé(e).

SQL> 
SQL> CREATE OR REPLACE PACKAGE pkg_reparti AS
  2  
  3      -- Nom du lien vers un site (lu dans catalogue_site)
  4      FUNCTION lien (p_id_site IN NUMBER) RETURN VARCHAR2;
  5  
  6      -- Vrai si l'erreur courante signifie « site injoignable » (compte bloqué, service
  7      -- arrêté, connexion coupée…)
  8      FUNCTION erreur_de_lien (p_code IN NUMBER) RETURN BOOLEAN;
  9  
 10      -- Parcours multi-sites sur les fragments : tout ou rien, refuse la sur-réservation
 11      -- et refuse tout le parcours si un des sites est injoignable. COMMIT par l'appelant.
 12      PROCEDURE inscrire_parcours (
 13          p_id_etudiant     IN  NUMBER,
 14          p_sessions        IN  t_liste_sessions,
 15          p_nb_places       IN  NUMBER DEFAULT 1,
 16          p_date_operation  IN  DATE DEFAULT SYSDATE,
 17          p_id_groupe       OUT VARCHAR2);
 18  
 19      -- Inscription simple. p_etat = 'INSCRITE' (posée dans le site) ou 'EN_ATTENTE'
 20      -- (site en panne : gardée au siège). COMMIT par l'appelant.
 21      PROCEDURE inscrire (
 22          p_id_etudiant     IN  NUMBER,
 23          p_id_session      IN  NUMBER,
 24          p_nb_places       IN  NUMBER DEFAULT 1,
 25          p_date_operation  IN  DATE DEFAULT SYSDATE,
 26          p_id_inscription  OUT NUMBER,
 27          p_etat            OUT VARCHAR2);
 28  
 29      -- Reprise d'un site : rejoue ses opérations en attente, dans l'ordre d'arrivée.
 30      -- Une opération qui n'a plus de place est REFUSEE (avec son motif), pas forcée.
 31      PROCEDURE rejouer_attente (p_id_site IN NUMBER);
 32  
 33      -- Catalogue d'un site : les p_nb_max prochaines sessions à partir de p_a_partir_de,
 34      -- affichées par DBMS_OUTPUT. p_source = 'SITE' (lu dans le site) ou 'REPLIQUE'
 35      -- (site en panne : lu dans la copie du siège). -20026 si le site est en panne et
 36      -- n'a pas de copie.
 37      PROCEDURE consulter_sessions (
 38          p_id_site      IN  NUMBER,
 39          p_a_partir_de  IN  DATE,
 40          p_nb_max       IN  NUMBER DEFAULT 5,
 41          p_source       OUT VARCHAR2);
 42  
 43      -- Resynchronise la copie d'un site avec son fragment (le dernier écrivain gagne).
 44      -- p_vers_site : lignes recopiées de la copie vers le site (plus récentes au siège) ;
 45      -- p_vers_replique : lignes recopiées du site vers la copie. COMMIT par l'appelant
 46      -- (validation à deux phases : le siège et le site sont modifiés ensemble).
 47      PROCEDURE synchroniser_replique (
 48          p_id_site        IN  NUMBER,
 49          p_vers_site      OUT NUMBER,
 50          p_vers_replique  OUT NUMBER);
 51  
 52  END pkg_reparti;
 53  /

Elément Package PKG_REPARTI compilé

SQL> 
SQL> CREATE OR REPLACE PACKAGE BODY pkg_reparti AS
  2  
  3      FUNCTION lien (p_id_site IN NUMBER) RETURN VARCHAR2 IS
  4          v_lien catalogue_site.nom_lien%TYPE;
  5      BEGIN
  6          SELECT nom_lien INTO v_lien FROM catalogue_site WHERE id_site = p_id_site;
  7          RETURN v_lien;
  8      EXCEPTION
  9          WHEN NO_DATA_FOUND THEN
 10              RAISE_APPLICATION_ERROR(-20020, 'Site ' || p_id_site || ' absent du catalogue de répartition');
 11      END lien;
 12  
 13  
 14      FUNCTION erreur_de_lien (p_code IN NUMBER) RETURN BOOLEAN IS
 15      BEGIN
 16          -- 28000 compte bloqué, 1017 mot de passe refusé, 2063/2068 erreur venue du lien,
 17          -- 3113/3114/3135/3150 connexion coupée, 12514/12541/12170 service ou réseau
 18          -- absent, 2019 lien inconnu
 19          RETURN p_code IN (-28000, -1017, -2063, -2068, -3113, -3114, -3135, -3150,
 20                            -12514, -12541, -12170, -2019);
 21      END erreur_de_lien;
 22  
 23  
 24      -- Ferme le lien après une erreur, pour que l'appel suivant retente une connexion
 25      -- au lieu de réutiliser une session morte
 26      PROCEDURE fermer_lien (p_lien IN VARCHAR2) IS
 27      BEGIN
 28          EXECUTE IMMEDIATE 'ALTER SESSION CLOSE DATABASE LINK ' || p_lien;
 29      EXCEPTION
 30          WHEN OTHERS THEN NULL;   -- lien déjà fermé, ou transaction en cours
 31      END fermer_lien;
 32  
 33  
 34      -- Site d'une session, lu dans l'annuaire du siège (pas besoin que le site réponde)
 35      FUNCTION site_de_session (p_id_session IN NUMBER) RETURN NUMBER IS
 36          v_site NUMBER;
 37      BEGIN
 38          SELECT id_site INTO v_site FROM v_annuaire_session WHERE id_session = p_id_session;
 39          RETURN v_site;
 40      EXCEPTION
 41          WHEN NO_DATA_FOUND THEN
 42              RAISE_APPLICATION_ERROR(-20022, 'Session ' || p_id_session || ' inexistante (RG11)');
 43      END site_de_session;
 44  
 45  
 46      PROCEDURE verifier_etudiant (p_id_etudiant IN NUMBER) IS
 47          v_nb NUMBER;
 48      BEGIN
 49          SELECT COUNT(*) INTO v_nb FROM v_annuaire_etudiant WHERE id_etudiant = p_id_etudiant;
 50          IF v_nb = 0 THEN
 51              RAISE_APPLICATION_ERROR(-20023, 'Étudiant ' || p_id_etudiant || ' inexistant');
 52          END IF;
 53      END verifier_etudiant;
 54  
 55  
 56      -- Verrouille la session dans son site, vérifie la place et pose l'inscription.
 57      -- Même contrôle que pkg_parcours (L4), mais à travers le lien du site.
 58      PROCEDURE poser_inscription (
 59          p_id_inscription IN NUMBER, p_id_etudiant IN NUMBER, p_id_session IN NUMBER,
 60          p_id_site IN NUMBER, p_id_groupe IN VARCHAR2, p_nb_places IN NUMBER,
 61          p_date_operation IN DATE)
 62      IS
 63          v_lien      catalogue_site.nom_lien%TYPE := lien(p_id_site);
 64          v_capacite  NUMBER;
 65          v_prix      NUMBER;
 66          v_debut     DATE;
 67          v_occupees  NUMBER;
 68      BEGIN
 69          -- Verrou de la ligne de la session dans le site (correction de concurrence du L4)
 70          EXECUTE IMMEDIATE 'SELECT capacite, prix_unitaire, debut FROM session_cours@' || v_lien
 71              || ' WHERE id_session = :s FOR UPDATE'
 72              INTO v_capacite, v_prix, v_debut USING p_id_session;
 73  
 74          IF p_date_operation > v_debut THEN
 75              RAISE_APPLICATION_ERROR(-20024, 'Session ' || p_id_session
 76                  || ' déjà commencée le ' || TO_CHAR(v_debut, 'DD/MM/YYYY') || ' (RG11)');
 77          END IF;
 78  
 79          EXECUTE IMMEDIATE 'SELECT NVL(SUM(nb_places), 0) FROM inscription@' || v_lien
 80              || ' WHERE id_session = :s AND statut = ''CONFIRMEE'''
 81              INTO v_occupees USING p_id_session;
 82  
 83          IF v_capacite - v_occupees < p_nb_places THEN
 84              RAISE_APPLICATION_ERROR(-20021, 'Session ' || p_id_session || ' : '
 85                  || GREATEST(v_capacite - v_occupees, 0) || ' place(s) libre(s) sur '
 86                  || v_capacite || ', ' || p_nb_places || ' demandée(s) (RG15)');
 87          END IF;
 88  
 89          EXECUTE IMMEDIATE 'INSERT INTO inscription@' || v_lien
 90              || ' (id_inscription, id_etudiant, id_session, id_groupe, date_operation,'
 91              || '  nb_places, montant, statut, id_site)'
 92              || ' VALUES (:i, :e, :s, :g, :d, :n, :m, ''CONFIRMEE'', :site)'
 93              USING p_id_inscription, p_id_etudiant, p_id_session, p_id_groupe,
 94                    p_date_operation, p_nb_places, p_nb_places * v_prix, p_id_site;
 95      END poser_inscription;
 96  
 97  
 98      PROCEDURE inscrire_parcours (
 99          p_id_etudiant     IN  NUMBER,
100          p_sessions        IN  t_liste_sessions,
101          p_nb_places       IN  NUMBER DEFAULT 1,
102          p_date_operation  IN  DATE DEFAULT SYSDATE,
103          p_id_groupe       OUT VARCHAR2)
104      IS
105          v_nb       NUMBER;
106          v_distinct NUMBER;
107          v_site     NUMBER;
108          v_code     NUMBER;
109          v_message  VARCHAR2(512);
110      BEGIN
111          SELECT COUNT(*), COUNT(DISTINCT column_value) INTO v_nb, v_distinct FROM TABLE(p_sessions);
112          IF v_nb < 2 OR v_distinct < v_nb THEN
113              RAISE_APPLICATION_ERROR(-20025,
114                  'Un parcours compte au moins 2 sessions différentes');
115          END IF;
116          verifier_etudiant(p_id_etudiant);
117  
118          SAVEPOINT avant_parcours_reparti;
119          BEGIN
120              p_id_groupe := 'G' || TO_CHAR(seq_groupe.NEXTVAL, 'FM00000');
121  
122              -- Ordre croissant des sessions : même ordre de verrouillage pour tous
123              FOR s IN (SELECT column_value AS id_session FROM TABLE(p_sessions) ORDER BY 1) LOOP
124                  v_site := site_de_session(s.id_session);
125                  poser_inscription(seq_inscription.NEXTVAL, p_id_etudiant, s.id_session,
126                                    v_site, p_id_groupe, p_nb_places, p_date_operation);
127              END LOOP;
128          EXCEPTION
129              WHEN OTHERS THEN
130                  v_code    := SQLCODE;
131                  v_message := SQLERRM;
132                  -- Tout ou rien, sur tous les sites à la fois : le retour au point de
133                  -- sauvegarde défait aussi les lignes déjà posées dans les autres sites
134                  ROLLBACK TO SAVEPOINT avant_parcours_reparti;
135                  p_id_groupe := NULL;
136                  IF erreur_de_lien(v_code) THEN
137                      fermer_lien(lien(v_site));
138                      RAISE_APPLICATION_ERROR(-20020, 'Site ' || v_site
139                          || ' injoignable : parcours refusé en entier, aucun site modifié ('
140                          || v_message || ')');
141                  END IF;
142                  RAISE;
143          END;
144      END inscrire_parcours;
145  
146  
147      PROCEDURE inscrire (
148          p_id_etudiant     IN  NUMBER,
149          p_id_session      IN  NUMBER,
150          p_nb_places       IN  NUMBER DEFAULT 1,
151          p_date_operation  IN  DATE DEFAULT SYSDATE,
152          p_id_inscription  OUT NUMBER,
153          p_etat            OUT VARCHAR2)
154      IS
155          v_site    NUMBER := site_de_session(p_id_session);
156          v_message VARCHAR2(512);
157      BEGIN
158          verifier_etudiant(p_id_etudiant);
159          p_id_inscription := seq_inscription.NEXTVAL;
160  
161          SAVEPOINT avant_inscription;
162          BEGIN
163              poser_inscription(p_id_inscription, p_id_etudiant, p_id_session, v_site,
164                                NULL, p_nb_places, p_date_operation);
165              p_etat := 'INSCRITE';
166          EXCEPTION
167              WHEN OTHERS THEN
168                  IF NOT erreur_de_lien(SQLCODE) THEN RAISE; END IF;
169                  v_message := SUBSTR(SQLERRM, 1, 200);
170                  -- Site en panne : on garde la demande au siège, avec le même numéro
171                  -- d'inscription, pour la rejouer à la reprise
172                  ROLLBACK TO SAVEPOINT avant_inscription;
173                  fermer_lien(lien(v_site));
174                  INSERT INTO operation_en_attente (id_site, id_inscription, id_etudiant,
175                              id_session, nb_places, date_operation, motif)
176                  VALUES (v_site, p_id_inscription, p_id_etudiant, p_id_session,
177                          p_nb_places, p_date_operation, v_message);
178                  p_etat := 'EN_ATTENTE';
179          END;
180      END inscrire;
181  
182  
183      PROCEDURE rejouer_attente (p_id_site IN NUMBER) IS
184          v_code    NUMBER;
185          v_message VARCHAR2(200);
186      BEGIN
187          FOR a IN (SELECT * FROM operation_en_attente
188                    WHERE  id_site = p_id_site AND etat = 'EN_ATTENTE'
189                    ORDER BY id_attente) LOOP
190              SAVEPOINT avant_rejeu;
191              BEGIN
192                  poser_inscription(a.id_inscription, a.id_etudiant, a.id_session, a.id_site,
193                                    NULL, a.nb_places, a.date_operation);
194                  UPDATE operation_en_attente SET etat = 'REJOUEE', motif = NULL
195                  WHERE  id_attente = a.id_attente;
196              EXCEPTION
197                  WHEN OTHERS THEN
198                      v_code    := SQLCODE;
199                      v_message := SUBSTR(SQLERRM, 1, 200);
200                      ROLLBACK TO SAVEPOINT avant_rejeu;
201                      -- Site toujours en panne : on arrête, tout reste en attente
202                      IF erreur_de_lien(v_code) THEN RAISE; END IF;
203                      -- Sinon (session pleine entre-temps…) : refus tracé, pas de forçage
204                      UPDATE operation_en_attente
205                      SET    etat = 'REFUSEE', motif = v_message
206                      WHERE  id_attente = a.id_attente;
207              END;
208          END LOOP;
209      END rejouer_attente;
210  
211  
212      PROCEDURE consulter_sessions (
213          p_id_site      IN  NUMBER,
214          p_a_partir_de  IN  DATE,
215          p_nb_max       IN  NUMBER DEFAULT 5,
216          p_source       OUT VARCHAR2)
217      IS
218          TYPE t_ligne IS RECORD (id_session NUMBER, libelle VARCHAR2(80 CHAR), debut DATE,
219                                  capacite NUMBER, prix_unitaire NUMBER);
220          TYPE t_lignes IS TABLE OF t_ligne;
221          v_lignes  t_lignes;
222          v_lien    catalogue_site.nom_lien%TYPE := lien(p_id_site);
223          v_code    NUMBER;
224          v_message VARCHAR2(512);
225      BEGIN
226          -- 1. Le site principal. Toutes les lignes sont lues dans ce bloc (BULK COLLECT) :
227          --    une coupure pendant la lecture fait aussi basculer. Le lien est écrit en SQL
228          --    dynamique : la procédure reste valide pendant la panne (piège PLS-00905
229          --    signalé au Lab 5).
230          BEGIN
231              EXECUTE IMMEDIATE 'SELECT id_session, libelle, debut, capacite, prix_unitaire'
232                  || ' FROM session_cours@' || v_lien
233                  || ' WHERE debut >= :d ORDER BY debut, id_session FETCH FIRST :n ROWS ONLY'
234                  BULK COLLECT INTO v_lignes USING p_a_partir_de, p_nb_max;
235              p_source := 'SITE';
236          EXCEPTION
237              WHEN OTHERS THEN
238                  v_code    := SQLCODE;
239                  v_message := SQLERRM;
240                  IF NOT erreur_de_lien(v_code) THEN RAISE; END IF;
241                  fermer_lien(v_lien);
242                  DBMS_OUTPUT.PUT_LINE('Site ' || p_id_site || ' injoignable : '
243                      || REPLACE(v_message, CHR(10), ' '));
244  
245                  -- 2. Bascule sur la copie du siège
246                  SELECT id_session, libelle, debut, capacite, prix_unitaire
247                  BULK COLLECT INTO v_lignes
248                  FROM   session_replique
249                  WHERE  id_campus = p_id_site AND debut >= p_a_partir_de
250                  ORDER BY debut, id_session
251                  FETCH FIRST p_nb_max ROWS ONLY;
252  
253                  IF v_lignes.COUNT = 0 THEN
254                      RAISE_APPLICATION_ERROR(-20026, 'Site ' || p_id_site
255                          || ' injoignable et sans copie au siège');
256                  END IF;
257                  DBMS_OUTPUT.PUT_LINE('Bascule sur la copie du siège (SESSION_REPLIQUE)');
258                  p_source := 'REPLIQUE';
259          END;
260  
261          DBMS_OUTPUT.PUT_LINE('Sessions du site ' || p_id_site || ' lues dans : ' || p_source);
262          FOR i IN 1 .. v_lignes.COUNT LOOP
263              DBMS_OUTPUT.PUT_LINE('  session ' || v_lignes(i).id_session || ', '
264                  || TO_CHAR(v_lignes(i).debut, 'DD/MM/YYYY HH24:MI') || ', '
265                  || v_lignes(i).libelle || ', ' || v_lignes(i).capacite || ' places, '
266                  || TO_CHAR(v_lignes(i).prix_unitaire, 'FM99990.00') || ' EUR');
267          END LOOP;
268      END consulter_sessions;
269  
270  
271      PROCEDURE synchroniser_replique (
272          p_id_site        IN  NUMBER,
273          p_vers_site      OUT NUMBER,
274          p_vers_replique  OUT NUMBER)
275      IS
276          TYPE t_sessions IS TABLE OF session_replique%ROWTYPE;
277          v_plus_recentes t_sessions;
278          v_lien          catalogue_site.nom_lien%TYPE := lien(p_id_site);
279          v_code          NUMBER;
280          v_message       VARCHAR2(512);
281      BEGIN
282          -- 1. Sessions plus récentes dans la copie (modifiées au siège, par exemple pendant
283          --    une panne) : on les recopie dans le site
284          EXECUTE IMMEDIATE 'SELECT r.id_session, r.libelle, r.id_categorie, r.id_campus, r.debut,'
285              || ' r.duree_minutes, r.capacite, r.prix_unitaire, r.derniere_maj'
286              || ' FROM session_replique r JOIN session_cours@' || v_lien || ' s'
287              || ' ON s.id_session = r.id_session'
288              || ' WHERE r.id_campus = :site AND r.derniere_maj > s.derniere_maj'
289              BULK COLLECT INTO v_plus_recentes USING p_id_site;
290  
291          FOR i IN 1 .. v_plus_recentes.COUNT LOOP
292              EXECUTE IMMEDIATE 'UPDATE session_cours@' || v_lien
293                  || ' SET libelle = :l, id_categorie = :c, debut = :d, duree_minutes = :du,'
294                  || ' capacite = :ca, prix_unitaire = :p, derniere_maj = :m'
295                  || ' WHERE id_session = :id'
296                  USING v_plus_recentes(i).libelle, v_plus_recentes(i).id_categorie,
297                        v_plus_recentes(i).debut, v_plus_recentes(i).duree_minutes,
298                        v_plus_recentes(i).capacite, v_plus_recentes(i).prix_unitaire,
299                        v_plus_recentes(i).derniere_maj, v_plus_recentes(i).id_session;
300          END LOOP;
301          p_vers_site := v_plus_recentes.COUNT;
302  
303          -- 2. Sessions plus récentes dans le site, ou nouvelles : on les recopie au siège.
304          --    Les lignes recopiées à l'étape 1 ont maintenant la même date des deux côtés :
305          --    elles ne bougent plus.
306          EXECUTE IMMEDIATE 'MERGE INTO session_replique r'
307              || ' USING (SELECT id_session, libelle, id_categorie, id_campus, debut,'
308              || '               duree_minutes, capacite, prix_unitaire, derniere_maj'
309              || '        FROM session_cours@' || v_lien || ') s'
310              || ' ON (r.id_session = s.id_session)'
311              || ' WHEN MATCHED THEN UPDATE SET r.libelle = s.libelle, r.id_categorie = s.id_categorie,'
312              || '      r.debut = s.debut, r.duree_minutes = s.duree_minutes, r.capacite = s.capacite,'
313              || '      r.prix_unitaire = s.prix_unitaire, r.derniere_maj = s.derniere_maj'
314              || '      WHERE s.derniere_maj > r.derniere_maj'
315              || ' WHEN NOT MATCHED THEN INSERT (id_session, libelle, id_categorie, id_campus, debut,'
316              || '      duree_minutes, capacite, prix_unitaire, derniere_maj)'
317              || '      VALUES (s.id_session, s.libelle, s.id_categorie, s.id_campus, s.debut,'
318              || '      s.duree_minutes, s.capacite, s.prix_unitaire, s.derniere_maj)';
319          p_vers_replique := SQL%ROWCOUNT;
320      EXCEPTION
321          WHEN OTHERS THEN
322              v_code    := SQLCODE;
323              v_message := SQLERRM;
324              IF erreur_de_lien(v_code) THEN
325                  fermer_lien(v_lien);
326                  RAISE_APPLICATION_ERROR(-20020, 'Site ' || p_id_site
327                      || ' injoignable : synchronisation impossible (' || v_message || ')');
328              END IF;
329              RAISE;
330      END synchroniser_replique;
331  
332  END pkg_reparti;
