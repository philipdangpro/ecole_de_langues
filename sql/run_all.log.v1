SQL> -- 7.4 Contraintes qu'aucun site ne peut garantir seul, vérifiées à travers les liens.
SQL> -- Piège mesuré : écrite avec NOT EXISTS, la requête a pris 4 min 27 s, car Oracle
SQL> -- interrogeait le site distant une fois par inscription (boucle imbriquée à travers le
SQL> -- lien). Le hint USE_HASH fait venir chaque côté une seule fois, puis joint au siège :
SQL> -- 0,3 s pour le même résultat.
SQL> SELECT /*+ USE_HASH(i e) NO_MERGE(i) NO_MERGE(e) */
  2         COUNT(*)                                               AS inscriptions,
  3         SUM(CASE WHEN e.id_etudiant IS NULL THEN 1 ELSE 0 END) AS inscriptions_orphelines,
  4         SUM(CASE WHEN e.id_campus <> i.id_site THEN 1 ELSE 0 END) AS inscriptions_etudiant_distant
  5  FROM      (SELECT id_etudiant, id_site   FROM v_g_inscription) i
  6  LEFT JOIN (SELECT id_etudiant, id_campus FROM v_g_etudiant)    e ON e.id_etudiant = i.id_etudiant;

