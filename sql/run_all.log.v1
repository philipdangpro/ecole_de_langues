SQL> -- Plan avant : 2 jointures par hachage et lecture complète d'INSCRIPTION et SESSION_COURS.
SQL> 
SQL> -- Optimisation : vue matérialisée par site, langue et MOIS de la session.
SQL> --   - Le mois permet d'autres tableaux (évolution mensuelle, rentrée de septembre) à
SQL> --     partir de la même vue : 3 sites x 6 langues x 24 mois, quelques centaines de lignes.
SQL> --   - ENABLE QUERY REWRITE : Oracle réécrit tout seul la requête Q3 (inchangée) pour lire
SQL> --     la vue au lieu des tables. Les programmes existants n'ont rien à changer.
SQL> --   - REFRESH COMPLETE ON DEMAND : recalculée à la demande (par exemple chaque nuit,
SQL> --     DBMS_MVIEW.REFRESH('MV_ACTIVITE_MENSUELLE')). Un tableau de bord tolère des chiffres
SQL> --     de la veille. Tant qu'elle n'est pas recalculée après une nouvelle inscription, Oracle
SQL> --     ne l'utilise plus pour réécrire (query_rewrite_integrity = enforced) : la requête
SQL> --     repasse sur les tables, plus lente mais jamais fausse.
SQL> CREATE MATERIALIZED VIEW mv_activite_mensuelle
  2  BUILD IMMEDIATE
  3  REFRESH COMPLETE ON DEMAND
  4  ENABLE QUERY REWRITE
  5  AS
  6  SELECT i.id_site,
  7         c.libelle                AS langue,
  8         TRUNC(s.debut, 'MM')     AS mois,
  9         COUNT(*)                 AS nb_inscriptions,
 10         SUM(i.nb_places)         AS places,
 11         SUM(i.montant)           AS ca
 12  FROM   inscription i
 13  JOIN   session_cours s ON s.id_session = i.id_session
 14  JOIN   categorie c     ON c.id_categorie = s.id_categorie
 15  WHERE  i.statut = 'CONFIRMEE'
 16  GROUP BY i.id_site, c.libelle, TRUNC(s.debut, 'MM');

Materialized view MV_ACTIVITE_MENSUELLE créé(e).

SQL> 
SQL> COMMENT ON MATERIALIZED VIEW mv_activite_mensuelle IS 'L5 : places et CA confirmés par site, langue et mois. Recalcul : DBMS_MVIEW.REFRESH.';

