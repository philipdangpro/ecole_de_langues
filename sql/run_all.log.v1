SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Liens de base de données, du siège vers chaque site
SQL> --    Sur trois serveurs, seule la chaîne USING changerait (hôte du site).
SQL> --    00_nettoyage.sql supprime les liens (type DATABASE LINK) au début de run_all.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE DATABASE LINK lien_bordeaux CONNECT TO site_bordeaux IDENTIFIED BY "site_bordeaux"
  2      USING '//localhost:1521/FREEPDB1';

Database link LIEN_BORDEAUX créé(e).

SQL> CREATE DATABASE LINK lien_tours    CONNECT TO site_tours    IDENTIFIED BY "site_tours"
  2      USING '//localhost:1521/FREEPDB1';

Database link LIEN_TOURS créé(e).

SQL> CREATE DATABASE LINK lien_angers   CONNECT TO site_angers   IDENTIFIED BY "site_angers"
  2      USING '//localhost:1521/FREEPDB1';

Database link LIEN_ANGERS créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. Création des fragments, à distance
SQL> --    Le siège ne peut pas écrire « CREATE TABLE …@lien » : il appelle, à travers le
SQL> --    lien, la procédure DBMS_UTILITY.EXEC_DDL_STATEMENT du site, qui exécute l'ordre
SQL> --    avec les droits du compte du site. Les sites n'ont donc besoin que de CREATE TABLE.
SQL> --
SQL> --    Chaque fragment porte son prédicat en contrainte CHECK (ck_..._fragment) : une ligne
SQL> --    d'un autre site est refusée par le site lui-même, la disjonction est garantie.
SQL> --
SQL> --    Contraintes qui ne peuvent PAS être posées dans un fragment (une contrainte Oracle
SQL> --    ne traverse pas un lien) :
SQL> --      - inscription.id_etudiant -> etudiant : 22 955 inscriptions (6,5 %) concernent un
SQL> --        étudiant rattaché à un autre site ;
SQL> --      - unicité de l'e-mail entre sites ; parrain d'un autre site.
SQL> --    Elles sont vérifiées par les requêtes de contrôle de la partie 7.
SQL> -- ---------------------------------------------------------------------
SQL> DECLARE
  2      PROCEDURE ddl (p_lien VARCHAR2, p_ordre VARCHAR2) IS
  3      BEGIN
  4          EXECUTE IMMEDIATE 'BEGIN DBMS_UTILITY.EXEC_DDL_STATEMENT@' || p_lien || '(:o); END;'
  5              USING p_ordre;
  6      END;
  7  BEGIN
  8      FOR s IN (SELECT id_site, nom_lien FROM catalogue_site ORDER BY id_site) LOOP
  9  
 10          -- Relançable : on repart de fragments vides (ordre inverse des clés étrangères)
 11          ddl(s.nom_lien, 'DROP TABLE IF EXISTS inscription   CASCADE CONSTRAINTS PURGE');
 12          ddl(s.nom_lien, 'DROP TABLE IF EXISTS session_cours CASCADE CONSTRAINTS PURGE');
 13          ddl(s.nom_lien, 'DROP TABLE IF EXISTS etudiant      CASCADE CONSTRAINTS PURGE');
 14          ddl(s.nom_lien, 'DROP TABLE IF EXISTS categorie     CASCADE CONSTRAINTS PURGE');
 15  
 16          ddl(s.nom_lien, '
 17              CREATE TABLE categorie (
 18                  id_categorie  NUMBER(4)          CONSTRAINT nn_categorie_id      NOT NULL,
 19                  libelle       VARCHAR2(40 CHAR)  CONSTRAINT nn_categorie_libelle NOT NULL,
 20                  CONSTRAINT pk_categorie         PRIMARY KEY (id_categorie),
 21                  CONSTRAINT uq_categorie_libelle UNIQUE (libelle))');
 22  
 23          ddl(s.nom_lien, '
 24              CREATE TABLE etudiant (
 25                  id_etudiant       NUMBER(8)          CONSTRAINT nn_etudiant_id     NOT NULL,
 26                  nom               VARCHAR2(80 CHAR)  CONSTRAINT nn_etudiant_nom    NOT NULL,
 27                  prenom            VARCHAR2(80 CHAR)  CONSTRAINT nn_etudiant_prenom NOT NULL,
 28                  email             VARCHAR2(254 CHAR),
 29                  telephone         VARCHAR2(10 CHAR),
 30                  ville             VARCHAR2(60 CHAR),
 31                  id_campus         NUMBER(4)          CONSTRAINT nn_etudiant_campus NOT NULL,
 32                  date_inscription  DATE               CONSTRAINT nn_etudiant_date   NOT NULL,
 33                  id_parrain        NUMBER(8),
 34                  CONSTRAINT pk_etudiant          PRIMARY KEY (id_etudiant),
 35                  CONSTRAINT uq_etudiant_email    UNIQUE (email),
 36                  CONSTRAINT ck_etudiant_fragment CHECK (id_campus = ' || s.id_site || '))');
 37  
 38          ddl(s.nom_lien, '
 39              CREATE TABLE session_cours (
 40                  id_session     NUMBER(8)          CONSTRAINT nn_session_id        NOT NULL,
 41                  libelle        VARCHAR2(80 CHAR)  CONSTRAINT nn_session_libelle   NOT NULL,
 42                  id_categorie   NUMBER(4)          CONSTRAINT nn_session_categorie NOT NULL,
 43                  id_campus      NUMBER(4)          CONSTRAINT nn_session_campus    NOT NULL,
 44                  debut          DATE               CONSTRAINT nn_session_debut     NOT NULL,
 45                  duree_minutes  NUMBER(3)          CONSTRAINT nn_session_duree     NOT NULL,
 46                  capacite       NUMBER(3)          CONSTRAINT nn_session_capacite  NOT NULL,
 47                  prix_unitaire  NUMBER(7,2)        CONSTRAINT nn_session_prix      NOT NULL,
 48                  derniere_maj   TIMESTAMP DEFAULT SYSTIMESTAMP
 49                                                    CONSTRAINT nn_session_maj       NOT NULL,
 50                  CONSTRAINT pk_session           PRIMARY KEY (id_session),
 51                  CONSTRAINT fk_session_categorie FOREIGN KEY (id_categorie)
 52                                                  REFERENCES categorie (id_categorie),
 53                  CONSTRAINT ck_session_capacite  CHECK (capacite > 0),
 54                  CONSTRAINT ck_session_prix      CHECK (prix_unitaire >= 0),
 55                  CONSTRAINT ck_session_fragment  CHECK (id_campus = ' || s.id_site || '))');
 56  
 57          ddl(s.nom_lien, '
 58              CREATE TABLE inscription (
 59                  id_inscription  NUMBER(10)         CONSTRAINT nn_inscription_id       NOT NULL,
 60                  id_etudiant     NUMBER(8)          CONSTRAINT nn_inscription_etudiant NOT NULL,
 61                  id_session      NUMBER(8)          CONSTRAINT nn_inscription_session  NOT NULL,
 62                  id_groupe       VARCHAR2(10 CHAR),
 63                  date_operation  DATE               CONSTRAINT nn_inscription_date     NOT NULL,
 64                  nb_places       NUMBER(3)          CONSTRAINT nn_inscription_places   NOT NULL,
 65                  montant         NUMBER(9,2)        CONSTRAINT nn_inscription_montant  NOT NULL,
 66                  statut          VARCHAR2(10 CHAR)  CONSTRAINT nn_inscription_statut   NOT NULL,
 67                  id_site         NUMBER(4)          CONSTRAINT nn_inscription_site     NOT NULL,
 68                  CONSTRAINT pk_inscription          PRIMARY KEY (id_inscription),
 69                  CONSTRAINT fk_inscription_session  FOREIGN KEY (id_session)
 70                                                     REFERENCES session_cours (id_session),
 71                  CONSTRAINT ck_inscription_places   CHECK (nb_places >= 1),
 72                  CONSTRAINT ck_inscription_statut   CHECK (statut IN (''CONFIRMEE'', ''ANNULEE'')),
 73                  CONSTRAINT ck_inscription_montant  CHECK (montant >= 0),
 74                  CONSTRAINT ck_inscription_fragment CHECK (id_site = ' || s.id_site || '))');
 75  
 76          -- Index du L5 (historique d''un étudiant, places d''une session), utiles aussi
 77          -- au contrôle de capacité de pkg_reparti
 78          ddl(s.nom_lien, 'CREATE INDEX ix_inscription_etudiant ON inscription (id_etudiant, id_session, statut)');
 79          ddl(s.nom_lien, 'CREATE INDEX ix_inscription_session  ON inscription (id_session, statut, nb_places)');
 80      END LOOP;
 81  END;
 82  /

Procédure PL/SQL terminée.

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 4. Remplissage des fragments depuis les tables centrales
SQL> --    INSERT …@lien SELECT … : le siège pousse vers chaque site les lignes de son
SQL> --    prédicat. Un COMMIT par site.
SQL> -- ---------------------------------------------------------------------
SQL> DECLARE
  2      v_lien catalogue_site.nom_lien%TYPE;
  3  BEGIN
  4      FOR s IN (SELECT id_site, nom_lien FROM catalogue_site ORDER BY id_site) LOOP
  5          v_lien := s.nom_lien;
  6  
  7          EXECUTE IMMEDIATE 'INSERT INTO categorie@' || v_lien
  8              || ' (id_categorie, libelle) SELECT id_categorie, libelle FROM categorie';
  9  
 10          EXECUTE IMMEDIATE 'INSERT INTO etudiant@' || v_lien
 11              || ' (id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription, id_parrain)'
 12              || ' SELECT id_etudiant, nom, prenom, email, telephone, ville, id_campus, date_inscription, id_parrain'
 13              || ' FROM etudiant WHERE id_campus = :s' USING s.id_site;
 14  
 15          EXECUTE IMMEDIATE 'INSERT INTO session_cours@' || v_lien
 16              || ' (id_session, libelle, id_categorie, id_campus, debut, duree_minutes, capacite, prix_unitaire)'
 17              || ' SELECT id_session, libelle, id_categorie, id_campus, debut, duree_minutes, capacite, prix_unitaire'
 18              || ' FROM session_cours WHERE id_campus = :s' USING s.id_site;
 19  
 20          EXECUTE IMMEDIATE 'INSERT INTO inscription@' || v_lien
 21              || ' (id_inscription, id_etudiant, id_session, id_groupe, date_operation, nb_places, montant, statut, id_site)'
 22              || ' SELECT id_inscription, id_etudiant, id_session, id_groupe, date_operation, nb_places, montant, statut, id_site'
 23              || ' FROM inscription WHERE id_site = :s' USING s.id_site;
 24  
 25          COMMIT;
 26      END LOOP;
 27  END;
 28  /

Procédure PL/SQL terminée.

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 4 bis. Redondance : une copie des sessions d'Angers au siège
SQL> --    Démarche du Lab 5 (partie 5, VOYAGE_NORD_REPLIQUE), appliquée à notre école.
SQL> --    Pourquoi SESSION_COURS : c'est le catalogue, lu à chaque consultation et à chaque
SQL> --    inscription, mais rarement modifié (création d'une session, changement de prix
SQL> --    ou de salle). Une copie coûte donc peu à tenir à jour. Les inscriptions, elles,
SQL> --    changent sans arrêt : on ne les recopie pas (la file d'attente s'en charge).
SQL> --    Pourquoi Angers seulement : c'est le site dont on simule la panne ; pour les autres
SQL> --    sites, ce serait la même table avec leurs lignes (colonne id_campus).
SQL> --
SQL> --    Mise à jour de la copie : différée, par pkg_reparti.synchroniser_replique (à la
SQL> --    reprise après une panne, et en temps normal à intervalle régulier, par exemple
SQL> --    chaque nuit). Chaque ligne porte la date de sa dernière modification
SQL> --    (derniere_maj, aussi dans les fragments) : quand la même session a été modifiée
SQL> --    des deux côtés, la modification la plus récente l'emporte (« le dernier écrivain
SQL> --    gagne »). Cela suppose des horloges synchronisées : ici, c'est la même instance.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE session_replique (
  2      id_session     NUMBER(8)          CONSTRAINT nn_repl_id        NOT NULL,
  3      libelle        VARCHAR2(80 CHAR)  CONSTRAINT nn_repl_libelle   NOT NULL,
  4      id_categorie   NUMBER(4)          CONSTRAINT nn_repl_categorie NOT NULL,
  5      id_campus      NUMBER(4)          CONSTRAINT nn_repl_campus    NOT NULL,
  6      debut          DATE               CONSTRAINT nn_repl_debut     NOT NULL,
  7      duree_minutes  NUMBER(3)          CONSTRAINT nn_repl_duree     NOT NULL,
  8      capacite       NUMBER(3)          CONSTRAINT nn_repl_capacite  NOT NULL,
  9      prix_unitaire  NUMBER(7,2)        CONSTRAINT nn_repl_prix      NOT NULL,
 10      derniere_maj   TIMESTAMP          CONSTRAINT nn_repl_maj       NOT NULL,
 11      CONSTRAINT pk_session_replique PRIMARY KEY (id_session),
 12      CONSTRAINT fk_repl_site        FOREIGN KEY (id_campus) REFERENCES catalogue_site (id_site),
 13      CONSTRAINT ck_repl_capacite    CHECK (capacite > 0),
 14      CONSTRAINT ck_repl_prix        CHECK (prix_unitaire >= 0)
 15  );

Table SESSION_REPLIQUE créé(e).

