SQL> CREATE TABLE l5_mesure (
  2      requete     VARCHAR2(4 CHAR)   CONSTRAINT nn_l5_mesure_requete NOT NULL,
  3      version     VARCHAR2(5 CHAR)   CONSTRAINT nn_l5_mesure_version NOT NULL,
  4      optimisation VARCHAR2(60 CHAR),
  5      blocs_lus   NUMBER,
  6      lignes      NUMBER,
  7      CONSTRAINT pk_l5_mesure PRIMARY KEY (requete, version),
  8      CONSTRAINT ck_l5_mesure_version CHECK (version IN ('AVANT', 'APRES'))
  9  );

