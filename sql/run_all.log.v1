SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 6. Inscriptions
SQL> --    On prépare chaque ligne une seule fois (vue en ligne « src ») : conversion des types,
SQL> --    rattachement des copies d'étudiants à l'original, calcul du motif de rejet.
SQL> --    Le format numérique est imposé (point décimal) : SQL Developer en français utiliserait
SQL> --    sinon la virgule et TO_NUMBER('309.00') échouerait.
SQL> -- ---------------------------------------------------------------------
SQL> INSERT ALL
  2      WHEN motif IS NULL THEN
  3          INTO inscription (id_inscription, id_etudiant, id_session, id_groupe, date_operation,
  4                            nb_places, montant, statut)
  5          VALUES (id_inscription, id_etudiant, id_session, id_groupe, date_operation,
  6                  nb_places, montant, statut)
  7      ELSE
  8          INTO inscription_rejet (id_inscription, id_etudiant, id_session, date_operation,
  9                                  nb_places, montant, statut, id_groupe, motif)
 10          VALUES (id_inscription, id_etudiant, id_session, date_operation,
 11                  nb_places, montant, statut, id_groupe, motif)
 12  SELECT i.id_inscription, NVL(d.id_original, i.id_etudiant) AS id_etudiant, i.id_session,
 13         i.id_groupe, i.date_operation, i.nb_places, i.montant, i.statut,
 14         CASE WHEN s.id_session IS NULL       THEN 'SESSION_INEXISTANTE'
 15              WHEN i.montant < 0              THEN 'MONTANT_NEGATIF'
 16              WHEN i.date_operation > s.debut THEN 'DATE_APRES_DEBUT'
 17         END AS motif
 18  FROM (
 19      SELECT TO_NUMBER(id_inscription)                               AS id_inscription,
 20             TO_NUMBER(id_etudiant)                                  AS id_etudiant,
 21             TO_NUMBER(id_session)                                   AS id_session,
 22             TRIM(id_groupe)                                         AS id_groupe,  -- vide -> NULL
 23             TO_DATE(TRIM(date_inscription), 'YYYY-MM-DD HH24:MI:SS') AS date_operation,
 24             TO_NUMBER(nb_places)                                    AS nb_places,
 25             TO_NUMBER(montant, '999999D99', 'NLS_NUMERIC_CHARACTERS=''.,''') AS montant,
 26             TRIM(statut)                                            AS statut
 27      FROM   ext_inscriptions
 28  ) i
 29  LEFT JOIN session_cours    s ON s.id_session = i.id_session
 30  LEFT JOIN etudiant_doublon d ON d.id_copie   = i.id_etudiant;

354 855 lignes inséré.

