SQL> @@06_triggers.sql
SQL> -- =====================================================================
SQL> -- 06_triggers.sql
SQL> -- Livrable : L4 · Fiabilité
SQL> -- Responsable : Baptiste (avec Claude Code)
SQL> -- Attendu  : au moins 2 triggers, dont un journal d'audit
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Contenu :
SQL> --   1. AUDIT_INSCRIPTION + trigger TRG_INSCRIPTION_AUDIT   : journal d'audit des opérations
SQL> --   2. TRG_INSCRIPTION_REGLES   : RG12 (montant calculé), RG11 (date <= début), RG14 (compte)
SQL> --   3. TRG_INSCRIPTION_DOUBLON  : RG13 (une seule inscription confirmée par étudiant et session)
SQL> --   4. TRG_ETUDIANT_PARRAIN     : RG7 (le parrain a un compte plus ancien)
SQL> --   Le trigger TRG_INSCRIPTION_SITE (remplit id_site) est créé au L3 (05_normalisation.sql).
SQL> --
SQL> -- Les triggers sont créés APRÈS le chargement (02) : ils ne contrôlent que les nouvelles
SQL> -- opérations. Les données historiques qui violent RG13 et RG14 restent telles quelles
SQL> -- (décision du L2 : elles sont valides au sens du sujet et comptent dans C3 à C9).
SQL> --
SQL> -- Codes d'erreur (RAISE_APPLICATION_ERROR) :
SQL> --   -20001 session inexistante (L3)     -20002 inscription avant la création du compte (RG14)
SQL> --   -20003 inscription après le début   -20004 étudiant déjà inscrit en confirmé (RG13)
SQL> --   -20005 parrain plus récent (RG7)    -20010 à -20019 : package du parcours (07)
SQL> -- Tests : preuves/L4_tests_fiabilite.sql
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Journal d'audit des inscriptions
SQL> --    Une ligne par inscription créée, modifiée ou supprimée : qui, quand, quoi, avant / après.
SQL> --    Pas de clé étrangère vers INSCRIPTION : la trace doit rester après un DELETE.
SQL> --    Pas de nom ni d'e-mail : l'id de l'étudiant suffit (minimisation RGPD).
SQL> --    Le trigger écrit dans la même transaction que l'opération : si l'opération est
SQL> --    annulée (ROLLBACK, parcours refusé), sa trace l'est aussi. Le journal ne contient donc
SQL> --    que ce qui a vraiment été enregistré. (Une transaction autonome garderait aussi les
SQL> --    tentatives refusées, mais elle tracerait des opérations qui n'ont jamais existé.)
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE audit_inscription (
  2      id_audit          NUMBER(12) GENERATED ALWAYS AS IDENTITY,
  3      date_action       TIMESTAMP          DEFAULT SYSTIMESTAMP
  4                                           CONSTRAINT nn_audit_date        NOT NULL,
  5      utilisateur       VARCHAR2(128 CHAR) CONSTRAINT nn_audit_utilisateur NOT NULL,
  6      action            VARCHAR2(6 CHAR)   CONSTRAINT nn_audit_action      NOT NULL,
  7      id_inscription    NUMBER(10)         CONSTRAINT nn_audit_inscription NOT NULL,
  8      id_etudiant       NUMBER(8),
  9      id_session        NUMBER(8),
 10      id_groupe         VARCHAR2(10 CHAR),
 11      ancien_statut     VARCHAR2(10 CHAR),
 12      nouveau_statut    VARCHAR2(10 CHAR),
 13      ancien_nb_places  NUMBER(3),
 14      nouveau_nb_places NUMBER(3),
 15      ancien_montant    NUMBER(9,2),
 16      nouveau_montant   NUMBER(9,2),
 17      CONSTRAINT pk_audit_inscription PRIMARY KEY (id_audit),
 18      CONSTRAINT ck_audit_action      CHECK (action IN ('INSERT', 'UPDATE', 'DELETE'))
 19  );

Table AUDIT_INSCRIPTION créé(e).

SQL> 
SQL> COMMENT ON TABLE audit_inscription IS 'L4 : journal d''audit des opérations (INSCRIPTION), rempli par trg_inscription_audit.';

Comment créé(e).

SQL> 
SQL> CREATE OR REPLACE TRIGGER trg_inscription_audit
  2  AFTER INSERT OR UPDATE OR DELETE ON inscription
  3  FOR EACH ROW
  4  DECLARE
  5      v_action audit_inscription.action%TYPE;
  6  BEGIN
  7      v_action := CASE WHEN INSERTING THEN 'INSERT' WHEN UPDATING THEN 'UPDATE' ELSE 'DELETE' END;
  8  
  9      INSERT INTO audit_inscription (
 10          utilisateur, action, id_inscription, id_etudiant, id_session, id_groupe,
 11          ancien_statut, nouveau_statut, ancien_nb_places, nouveau_nb_places,
 12          ancien_montant, nouveau_montant)
 13      VALUES (
 14          SYS_CONTEXT('USERENV', 'SESSION_USER'), v_action,
 15          NVL(:NEW.id_inscription, :OLD.id_inscription),
 16          NVL(:NEW.id_etudiant,    :OLD.id_etudiant),
 17          NVL(:NEW.id_session,     :OLD.id_session),
 18          NVL(:NEW.id_groupe,      :OLD.id_groupe),
 19          :OLD.statut,    :NEW.statut,             -- :OLD est vide pour un INSERT,
 20          :OLD.nb_places, :NEW.nb_places,          -- :NEW est vide pour un DELETE
 21          :OLD.montant,   :NEW.montant);
 22  END;
 23  /

Elément Trigger TRG_INSCRIPTION_AUDIT compilé

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Règles d'une inscription qui ne portent que sur la ligne et ses parents
SQL> --    RG12 : le montant est calculé (nb_places x prix de la session) ; une valeur fournie
SQL> --           par l'appelant est remplacée. Même principe que id_site au L3.
SQL> --    RG11 : une opération passée après le début de la session n'est pas valide : refusée.
SQL> --    RG14 : une inscription ne peut pas précéder la création du compte de l'étudiant.
SQL> --           Le compte est daté au jour près : une inscription le même jour est acceptée.
SQL> --    Ne se déclenche pas sur un simple changement de statut (annulation) : les lignes
SQL> --    historiques peuvent donc être annulées sans être revérifiées.
SQL> --    FOLLOWS : passe après TRG_INSCRIPTION_SITE, qui refuse déjà une session inexistante.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER trg_inscription_regles
  2  BEFORE INSERT OR UPDATE OF id_session, id_etudiant, nb_places, montant, date_operation
  3  ON inscription
  4  FOR EACH ROW
  5  FOLLOWS trg_inscription_site
  6  DECLARE
  7      v_prix      session_cours.prix_unitaire%TYPE;
  8      v_debut     session_cours.debut%TYPE;
  9      v_creation  etudiant.date_inscription%TYPE;
 10  BEGIN
 11      SELECT prix_unitaire, debut INTO v_prix, v_debut
 12      FROM   session_cours
 13      WHERE  id_session = :NEW.id_session;
 14  
 15      -- RG12
 16      :NEW.montant := :NEW.nb_places * v_prix;
 17  
 18      -- RG11 (définition d'une opération valide)
 19      IF :NEW.date_operation > v_debut THEN
 20          RAISE_APPLICATION_ERROR(-20003,
 21              'Inscription du ' || TO_CHAR(:NEW.date_operation, 'DD/MM/YYYY HH24:MI')
 22              || ' après le début de la session ' || :NEW.id_session
 23              || ' (' || TO_CHAR(v_debut, 'DD/MM/YYYY HH24:MI') || ') : refusée (RG11)');
 24      END IF;
 25  
 26      -- RG14
 27      IF INSERTING OR UPDATING('date_operation') OR UPDATING('id_etudiant') THEN
 28          -- MAX renvoie NULL au lieu de NO_DATA_FOUND : un étudiant inexistant est
 29          -- refusé ensuite par la clé étrangère fk_inscription_etudiant.
 30          SELECT MAX(date_inscription) INTO v_creation
 31          FROM   etudiant
 32          WHERE  id_etudiant = :NEW.id_etudiant;
 33  
 34          IF TRUNC(:NEW.date_operation) < v_creation THEN
 35              RAISE_APPLICATION_ERROR(-20002,
 36                  'Inscription du ' || TO_CHAR(:NEW.date_operation, 'DD/MM/YYYY')
 37                  || ' antérieure à la création du compte de l''étudiant ' || :NEW.id_etudiant
 38                  || ' (' || TO_CHAR(v_creation, 'DD/MM/YYYY') || ') : refusée (RG14)');
 39          END IF;
 40      END IF;
 41  END;
 42  /

Elément Trigger TRG_INSCRIPTION_REGLES compilé

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. RG13 : un étudiant n'a qu'une inscription confirmée par session
SQL> --    La règle porte sur plusieurs lignes d'INSCRIPTION. Un trigger ligne ne peut pas lire
SQL> --    la table qu'il modifie (ORA-04091, table en mutation) dès qu'un ordre touche plusieurs
SQL> --    lignes. D'où un trigger composé : chaque ligne note son couple (étudiant, session),
SQL> --    et la vérification se fait une fois l'ordre terminé (AFTER STATEMENT).
SQL> --    Pas d'index unique : les 154 couples historiques en double l'empêcheraient.
SQL> --    Seuls les couples touchés par l'ordre sont vérifiés : l'historique n'est pas relu.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER trg_inscription_doublon
  2  FOR INSERT OR UPDATE OF statut, id_etudiant, id_session ON inscription
  3  COMPOUND TRIGGER
  4  
  5      TYPE t_couple  IS RECORD (id_etudiant NUMBER(8), id_session NUMBER(8));
  6      TYPE t_couples IS TABLE OF t_couple;
  7      g_couples t_couples := t_couples();
  8  
  9      AFTER EACH ROW IS
 10      BEGIN
 11          IF :NEW.statut = 'CONFIRMEE' THEN
 12              g_couples.EXTEND;
 13              g_couples(g_couples.LAST).id_etudiant := :NEW.id_etudiant;
 14              g_couples(g_couples.LAST).id_session  := :NEW.id_session;
 15          END IF;
 16      END AFTER EACH ROW;
 17  
 18      AFTER STATEMENT IS
 19          v_nb NUMBER;
 20      BEGIN
 21          FOR k IN 1 .. g_couples.COUNT LOOP
 22              SELECT COUNT(*) INTO v_nb
 23              FROM   inscription
 24              WHERE  id_etudiant = g_couples(k).id_etudiant
 25              AND    id_session  = g_couples(k).id_session
 26              AND    statut      = 'CONFIRMEE';
 27  
 28              IF v_nb > 1 THEN
 29                  RAISE_APPLICATION_ERROR(-20004,
 30                      'L''étudiant ' || g_couples(k).id_etudiant
 31                      || ' est déjà inscrit en confirmé à la session '
 32                      || g_couples(k).id_session || ' : refusé (RG13)');
 33              END IF;
 34          END LOOP;
 35      END AFTER STATEMENT;
 36  
 37  END trg_inscription_doublon;
 38  /

Elément Trigger TRG_INSCRIPTION_DOUBLON compilé

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 4. RG7 : le parrain a un compte strictement plus ancien que son filleul
SQL> --    Même raison que pour RG13 (le parrain est dans la même table ETUDIANT) : trigger composé.
SQL> --    On vérifie l'étudiant modifié comme filleul (son parrain) et comme parrain (ses
SQL> --    filleuls), car changer la date de création d'un parrain peut casser la règle.
SQL> --    Le CHECK ck_etudiant_pas_son_parrain (L1) refuse déjà d'être son propre parrain.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER trg_etudiant_parrain
  2  FOR INSERT OR UPDATE OF id_parrain, date_inscription ON etudiant
  3  COMPOUND TRIGGER
  4  
  5      TYPE t_ids IS TABLE OF NUMBER(8);
  6      g_ids t_ids := t_ids();
  7  
  8      AFTER EACH ROW IS
  9      BEGIN
 10          g_ids.EXTEND;
 11          g_ids(g_ids.LAST) := :NEW.id_etudiant;
 12      END AFTER EACH ROW;
 13  
 14      AFTER STATEMENT IS
 15          v_filleul NUMBER(8);
 16          v_parrain NUMBER(8);
 17      BEGIN
 18          FOR k IN 1 .. g_ids.COUNT LOOP
 19              SELECT MIN(f.id_etudiant), MIN(p.id_etudiant) INTO v_filleul, v_parrain
 20              FROM   etudiant f
 21              JOIN   etudiant p ON p.id_etudiant = f.id_parrain
 22              WHERE  (f.id_etudiant = g_ids(k) OR p.id_etudiant = g_ids(k))
 23              AND    p.date_inscription >= f.date_inscription;
 24  
 25              IF v_filleul IS NOT NULL THEN
 26                  RAISE_APPLICATION_ERROR(-20005,
 27                      'Le parrain ' || v_parrain || ' n''a pas un compte plus ancien que son filleul '
 28                      || v_filleul || ' : refusé (RG7)');
 29              END IF;
 30          END LOOP;
 31      END AFTER STATEMENT;
 32  
 33  END trg_etudiant_parrain;
 34  /

Elément Trigger TRG_ETUDIANT_PARRAIN compilé

SQL> 
SQL> 
SQL> -- Contrôle : les 5 triggers du schéma (1 du L3, 4 du L4) sont compilés et actifs
SQL> COLUMN trigger_name FORMAT A25
SQL> COLUMN table_name   FORMAT A15
SQL> COLUMN trigger_type FORMAT A20
SQL> SELECT t.trigger_name, t.table_name, t.trigger_type, t.status, o.status AS compilation
  2  FROM   user_triggers t
  3  JOIN   user_objects  o ON o.object_name = t.trigger_name AND o.object_type = 'TRIGGER'
  4  ORDER BY t.table_name, t.trigger_name;

TRIGGER_NAME              TABLE_NAME      TRIGGER_TYPE         STATUS   COMPILA
------------------------- --------------- -------------------- -------- -------
TRG_ETUDIANT_PARRAIN      ETUDIANT        COMPOUND             ENABLED  VALID  
TRG_INSCRIPTION_AUDIT     INSCRIPTION     AFTER EACH ROW       ENABLED  VALID  
TRG_INSCRIPTION_DOUBLON   INSCRIPTION     COMPOUND             ENABLED  VALID  
TRG_INSCRIPTION_REGLES    INSCRIPTION     BEFORE EACH ROW      ENABLED  VALID  
TRG_INSCRIPTION_SITE      INSCRIPTION     BEFORE EACH ROW      ENABLED  VALID  

