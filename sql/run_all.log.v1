SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- C1 : nombre de personnes distinctes
SQL> --    Les doublons (même e-mail une fois en minuscules et sans espaces) ont été fusionnés
SQL> --    au chargement : une ligne d'ETUDIANT = une personne.
SQL> -- ---------------------------------------------------------------------
SQL> SELECT COUNT(*) AS c1
  2  FROM etudiant;

        C1
----------
     21471

SQL> -- Résultat : 21 471
SQL> 
SQL> -- Vérification sur le CSV brut (table externe, avant fusion), avec la règle du sujet :
SQL> --   e-mails distincts une fois normalisés + lignes sans e-mail (une personne chacune).
SQL> --   COUNT(*) - COUNT(email) = nombre de lignes sans e-mail (COUNT(email) ignore les NULL).
SQL> SELECT COUNT(*) AS lignes_csv,
  2         COUNT(DISTINCT LOWER(REPLACE(email, ' ', ''))) + COUNT(*) - COUNT(email) AS c1
  3  FROM ext_etudiants;

LIGNES_CSV         C1
---------- ----------
     21544      21471

SQL> -- Résultat : 21 544 lignes, 21 471 personnes (identique à C1 : la fusion est juste)
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- C4 : le jour où le plus d'opérations valides ont été passées, et leur nombre
SQL> --    Toutes les opérations valides comptent (confirmées et annulées).
SQL> --    TRUNC enlève l'heure de date_operation pour regrouper par jour.
SQL> -- ---------------------------------------------------------------------
SQL> SELECT TRUNC(date_operation) AS jour, COUNT(*) AS cpt
  2  FROM inscription
  3  GROUP BY TRUNC(date_operation)
  4  ORDER BY cpt DESC
  5  FETCH FIRST 1 ROWS ONLY;

