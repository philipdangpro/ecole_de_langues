SQL> @@02_chargement.sql
SQL> -- =====================================================================
SQL> -- 02_chargement.sql
SQL> -- Livrable : L2 · Chargement
SQL> -- Attendu  : chargement des 4 CSV de data/ avec traitement des défauts (correction, rejet tracé, signalement)
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Prérequis : sql/installation_system.sql a été lancé une fois (DIRECTORY dir_donnees_langues
SQL> -- qui pointe vers les CSV copiés dans le conteneur, voir README).
SQL> --
SQL> -- Méthode : chaque CSV est lu par une TABLE EXTERNE (le fichier reste sur le disque, Oracle le
SQL> -- lit comme une table), puis copié dans les tables du L1 par INSERT ... SELECT.
SQL> --
SQL> -- Défauts traités ici (seulement ceux qui empêcheraient le chargement) :
SQL> --   1. 73 étudiants en double (même e-mail une fois normalisé) : on garde l'original (le plus
SQL> --      petit id), la copie est tracée dans ETUDIANT_DOUBLON, ses inscriptions sont rattachées
SQL> --      à l'original.
SQL> --   2. 397 inscriptions non valides au sens du sujet (session inexistante, montant négatif,
SQL> --      date après le début de la session) : non chargées, tracées dans INSCRIPTION_REJET
SQL> --      avec leur motif.
SQL> -- Les autres défauts (doubles confirmations, inscriptions avant la création du compte,
SQL> -- sessions sur-réservées) ne rendent pas une opération non valide : ces lignes sont chargées
SQL> -- telles quelles et seront empêchées pour les nouvelles opérations en L4.
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Tables externes : une par CSV, toutes les colonnes lues en texte
SQL> --    (la conversion en nombre ou en date se fait à l'insertion, avec un format explicite).
SQL> --    DETECTED NEWLINE : accepte les fins de ligne Windows (CRLF) comme Unix (LF).
SQL> --    NOLOGFILE / NOBADFILE : Oracle n'a pas le droit d'écrire dans le dossier des CSV.
SQL> --    NOTRIM (étudiants seulement) : garde les espaces autour des e-mails, pour tracer le défaut
SQL> --    tel qu'il était dans le CSV.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE ext_campus (
  2      id_campus VARCHAR2(20), nom VARCHAR2(100), ville VARCHAR2(100), role VARCHAR2(20)
  3  )
  4  ORGANIZATION EXTERNAL (
  5      TYPE ORACLE_LOADER DEFAULT DIRECTORY dir_donnees_langues
  6      ACCESS PARAMETERS (
  7          RECORDS DELIMITED BY DETECTED NEWLINE CHARACTERSET AL32UTF8 SKIP 1
  8          NOLOGFILE NOBADFILE NODISCARDFILE
  9          FIELDS TERMINATED BY ',' MISSING FIELD VALUES ARE NULL
 10      )
 11      LOCATION ('campus.csv')
 12  ) REJECT LIMIT 0;

Table EXT_CAMPUS créé(e).

SQL> 
SQL> CREATE TABLE ext_etudiants (
  2      id_etudiant VARCHAR2(20), nom VARCHAR2(100), prenom VARCHAR2(100), email VARCHAR2(300),
  3      telephone VARCHAR2(30), ville VARCHAR2(100), id_campus VARCHAR2(20), date_inscription VARCHAR2(30)
  4  )
  5  ORGANIZATION EXTERNAL (
  6      TYPE ORACLE_LOADER DEFAULT DIRECTORY dir_donnees_langues
  7      ACCESS PARAMETERS (
  8          RECORDS DELIMITED BY DETECTED NEWLINE CHARACTERSET AL32UTF8 SKIP 1
  9          NOLOGFILE NOBADFILE NODISCARDFILE
 10          FIELDS TERMINATED BY ',' NOTRIM MISSING FIELD VALUES ARE NULL
 11      )
 12      LOCATION ('etudiants.csv')
 13  ) REJECT LIMIT 0;

Table EXT_ETUDIANTS créé(e).

SQL> 
SQL> CREATE TABLE ext_sessions (
  2      id_session VARCHAR2(20), libelle VARCHAR2(100), categorie VARCHAR2(50), id_campus VARCHAR2(20),
  3      debut VARCHAR2(30), duree_minutes VARCHAR2(20), capacite VARCHAR2(20), prix_unitaire VARCHAR2(20)
  4  )
  5  ORGANIZATION EXTERNAL (
  6      TYPE ORACLE_LOADER DEFAULT DIRECTORY dir_donnees_langues
  7      ACCESS PARAMETERS (
  8          RECORDS DELIMITED BY DETECTED NEWLINE CHARACTERSET AL32UTF8 SKIP 1
  9          NOLOGFILE NOBADFILE NODISCARDFILE
 10          FIELDS TERMINATED BY ',' MISSING FIELD VALUES ARE NULL
 11      )
 12      LOCATION ('sessions.csv')
 13  ) REJECT LIMIT 0;

Table EXT_SESSIONS créé(e).

SQL> 
SQL> CREATE TABLE ext_inscriptions (
  2      id_inscription VARCHAR2(20), id_etudiant VARCHAR2(20), id_session VARCHAR2(20),
  3      date_inscription VARCHAR2(30), nb_places VARCHAR2(20), montant VARCHAR2(20),
  4      statut VARCHAR2(20), id_groupe VARCHAR2(20)
  5  )
  6  ORGANIZATION EXTERNAL (
  7      TYPE ORACLE_LOADER DEFAULT DIRECTORY dir_donnees_langues
  8      ACCESS PARAMETERS (
  9          RECORDS DELIMITED BY DETECTED NEWLINE CHARACTERSET AL32UTF8 SKIP 1
 10          NOLOGFILE NOBADFILE NODISCARDFILE
 11          FIELDS TERMINATED BY ',' MISSING FIELD VALUES ARE NULL
 12      )
 13      LOCATION ('inscriptions.csv')
 14  ) REJECT LIMIT 0;

Table EXT_INSCRIPTIONS créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Tables de traçabilité des défauts
SQL> -- ---------------------------------------------------------------------
SQL> 
SQL> -- Étudiants en double : la copie n'est pas chargée dans ETUDIANT
SQL> CREATE TABLE etudiant_doublon (
  2      id_copie      NUMBER(8)          CONSTRAINT nn_doublon_copie    NOT NULL,
  3      id_original   NUMBER(8)          CONSTRAINT nn_doublon_original NOT NULL,
  4      email_source  VARCHAR2(254 CHAR),                     -- e-mail tel qu'il était dans le CSV
  5      CONSTRAINT pk_etudiant_doublon   PRIMARY KEY (id_copie),
  6      CONSTRAINT fk_doublon_original   FOREIGN KEY (id_original) REFERENCES etudiant (id_etudiant),
  7      CONSTRAINT ck_doublon_different  CHECK (id_copie <> id_original)
  8  );

Table ETUDIANT_DOUBLON créé(e).

SQL> 
SQL> -- Inscriptions non valides : gardées telles qu'elles étaient dans le CSV, avec le motif
SQL> CREATE TABLE inscription_rejet (
  2      id_inscription  NUMBER(10)         CONSTRAINT nn_rejet_id    NOT NULL,
  3      id_etudiant     NUMBER(8),
  4      id_session      NUMBER(8),
  5      date_operation  DATE,
  6      nb_places       NUMBER(3),
  7      montant         NUMBER(9,2),
  8      statut          VARCHAR2(10 CHAR),
  9      id_groupe       VARCHAR2(10 CHAR),
 10      motif           VARCHAR2(30 CHAR)  CONSTRAINT nn_rejet_motif NOT NULL,
 11      CONSTRAINT pk_inscription_rejet PRIMARY KEY (id_inscription),
 12      CONSTRAINT ck_rejet_motif CHECK (motif IN ('SESSION_INEXISTANTE', 'MONTANT_NEGATIF',
 13                                                 'DATE_APRES_DEBUT'))
 14  );

Table INSCRIPTION_REJET créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. Campus, siège, sites
SQL> --    Le CSV écrit le rôle « siège » / « site » ; on le traduit en SIEGE / SITE.
SQL> --    (LIKE 'si_ge' évite d'écrire un accent dans le script.)
SQL> -- ---------------------------------------------------------------------
SQL> INSERT INTO campus (id_campus, nom, ville, type_campus)
  2  SELECT TO_NUMBER(id_campus), TRIM(nom), TRIM(ville),
  3         CASE WHEN LOWER(TRIM(role)) = 'site'      THEN 'SITE'
  4              WHEN LOWER(TRIM(role)) LIKE 'si_ge'  THEN 'SIEGE'
  5         END                                     -- autre valeur : NULL, refusée par nn_campus_type
  6  FROM   ext_campus;

4 lignes inséré.

SQL> 
SQL> INSERT INTO siege (id_campus)
  2  SELECT id_campus FROM campus WHERE type_campus = 'SIEGE';

1 ligne inséré.

SQL> 
SQL> INSERT INTO site (id_campus, id_siege)
  2  SELECT c.id_campus, s.id_campus
