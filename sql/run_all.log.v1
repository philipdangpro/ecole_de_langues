SQL> @@07_package_parcours.sql
SQL> -- =====================================================================
SQL> -- 07_package_parcours.sql
SQL> -- Livrable : L4 · Fiabilité
SQL> -- Responsable : Baptiste (avec Claude Code)
SQL> -- Attendu  : package : procédure du parcours multi-sites, tout ou rien, qui refuse la sur-réservation
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Le parcours (opération groupée, RG16) : un étudiant s'inscrit en une fois à plusieurs
SQL> -- sessions, souvent dans plusieurs sites. Toutes les inscriptions partagent un id_groupe.
SQL> -- On impose au moins 2 sessions (comme les 2 667 parcours du CSV, qui en ont 2 à 4), mais
SQL> -- pas 2 sites : 793 parcours historiques restent sur un seul site, et C8 les distingue.
SQL> --
SQL> -- Contenu :
SQL> --   1. Séquences SEQ_INSCRIPTION et SEQ_GROUPE (numéros des nouvelles opérations)
SQL> --   2. Type T_LISTE_SESSIONS (la liste des sessions passée à la procédure)
SQL> --   3. Package PKG_PARCOURS :
SQL> --        inscrire_parcours  : tout ou rien, refuse la sur-réservation (RG15, RG16)
SQL> --        annuler_parcours   : annule toutes les inscriptions d'un parcours
SQL> --        places_restantes   : capacité - places confirmées d'une session
SQL> --
SQL> -- Le package ne fait ni COMMIT ni ROLLBACK complet : c'est l'appelant qui valide.
SQL> --   - en cas de succès : les inscriptions sont posées, l'appelant fait COMMIT ;
SQL> --   - en cas d'erreur  : ROLLBACK TO SAVEPOINT, la base revient à l'état d'avant l'appel
SQL> --     (même les inscriptions déjà posées dans la boucle), puis l'erreur est renvoyée.
SQL> -- Tests : preuves/L4_tests_fiabilite.sql. Concurrence : sql/L4_concurrence_session_A/B.sql
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Séquences
SQL> --    Elles démarrent après le plus grand numéro déjà utilisé, rejets compris : un id
SQL> --    écarté au chargement (INSCRIPTION_REJET) n'est jamais réattribué, la trace reste claire.
SQL> --    START WITH n'accepte pas de sous-requête, d'où le SQL dynamique.
SQL> -- ---------------------------------------------------------------------
SQL> DECLARE
  2      v_inscription NUMBER;
  3      v_groupe      NUMBER;
  4  BEGIN
  5      SELECT NVL(MAX(id_inscription), 0) + 1 INTO v_inscription
  6      FROM  (SELECT id_inscription FROM inscription
  7             UNION ALL
  8             SELECT id_inscription FROM inscription_rejet);
  9  
 10      SELECT NVL(MAX(TO_NUMBER(SUBSTR(id_groupe, 2))), 0) + 1 INTO v_groupe
 11      FROM  (SELECT id_groupe FROM inscription       WHERE id_groupe IS NOT NULL
 12             UNION ALL
 13             SELECT id_groupe FROM inscription_rejet WHERE id_groupe IS NOT NULL);
 14  
 15      EXECUTE IMMEDIATE 'CREATE SEQUENCE seq_inscription START WITH ' || v_inscription;
 16      -- MAXVALUE : le format G + 5 chiffres (ck_inscription_groupe) s'arrête à G99999
 17      EXECUTE IMMEDIATE 'CREATE SEQUENCE seq_groupe START WITH ' || v_groupe || ' MAXVALUE 99999';
 18  END;
 19  /

Procédure PL/SQL terminée.

SQL> 
SQL> COLUMN sequence_name FORMAT A16
SQL> SELECT sequence_name, last_number AS prochain_numero
  2  FROM   user_sequences
  3  WHERE  sequence_name IN ('SEQ_INSCRIPTION', 'SEQ_GROUPE')
  4  ORDER BY 1;

SEQUENCE_NAME    PROCHAIN_NUMERO
---------------- ---------------
SEQ_GROUPE                  2668
SEQ_INSCRIPTION           354856

SQL> -- Résultat : SEQ_GROUPE 2668 (dernier parcours : G02667), SEQ_INSCRIPTION 354856
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 2. Type de la liste de sessions
SQL> --    Type SQL (et non type déclaré dans le package) : il s'écrit directement à l'appel,
SQL> --    t_liste_sessions(101, 2045, 3310), et se lit en SQL avec TABLE(...).
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE TYPE t_liste_sessions AS TABLE OF NUMBER(8);
  2  /

Elément Type T_LISTE_SESSIONS compilé

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 3. Package
SQL> -- ---------------------------------------------------------------------
SQL> CREATE OR REPLACE PACKAGE pkg_parcours AS
  2  
  3      -- Inscrit p_id_etudiant à toutes les sessions de p_sessions, p_nb_places chacune,
  4      -- sous un nouvel id_groupe (renvoyé dans p_id_groupe). Tout ou rien : si une seule
  5      -- session est pleine ou si une règle est violée, aucune inscription n'est gardée.
  6      -- p_date_operation : date de l'opération, maintenant par défaut (paramètre utile pour
  7      -- les tests, les sessions du jeu de données s'arrêtant au 31/12/2026).
  8      PROCEDURE inscrire_parcours (
  9          p_id_etudiant     IN  etudiant.id_etudiant%TYPE,
 10          p_sessions        IN  t_liste_sessions,
 11          p_nb_places       IN  inscription.nb_places%TYPE DEFAULT 1,
 12          p_date_operation  IN  DATE DEFAULT SYSDATE,
 13          p_id_groupe       OUT inscription.id_groupe%TYPE);
 14  
 15      -- Annule toutes les inscriptions confirmées d'un parcours, en un seul ordre UPDATE
 16      -- (un parcours est confirmé ou annulé en entier : DF D9 du L3).
 17      PROCEDURE annuler_parcours (p_id_groupe IN inscription.id_groupe%TYPE);
 18  
 19      -- Places encore libres d'une session (négatif pour une session sur-réservée).
 20      FUNCTION places_restantes (p_id_session IN session_cours.id_session%TYPE) RETURN NUMBER;
 21  
 22  END pkg_parcours;
 23  /

Elément Package PKG_PARCOURS compilé

SQL> 
SQL> CREATE OR REPLACE PACKAGE BODY pkg_parcours AS
  2  
  3      FUNCTION places_restantes (p_id_session IN session_cours.id_session%TYPE) RETURN NUMBER IS
  4          v_capacite  session_cours.capacite%TYPE;
  5          v_occupees  NUMBER;
  6      BEGIN
  7          SELECT capacite INTO v_capacite FROM session_cours WHERE id_session = p_id_session;
  8  
  9          SELECT NVL(SUM(nb_places), 0) INTO v_occupees
 10          FROM   inscription
 11          WHERE  id_session = p_id_session
 12          AND    statut     = 'CONFIRMEE';
 13  
 14          RETURN v_capacite - v_occupees;
 15      END places_restantes;
 16  
 17  
 18      PROCEDURE inscrire_parcours (
 19          p_id_etudiant     IN  etudiant.id_etudiant%TYPE,
 20          p_sessions        IN  t_liste_sessions,
 21          p_nb_places       IN  inscription.nb_places%TYPE DEFAULT 1,
 22          p_date_operation  IN  DATE DEFAULT SYSDATE,
 23          p_id_groupe       OUT inscription.id_groupe%TYPE)
 24      IS
 25          v_nb_sessions  NUMBER;
 26          v_nb_distinct  NUMBER;
 27          v_capacite     session_cours.capacite%TYPE;
 28          v_restantes    NUMBER;
 29      BEGIN
 30          -- Contrôles de la demande, avant toute écriture
 31          SELECT COUNT(*), COUNT(DISTINCT column_value) INTO v_nb_sessions, v_nb_distinct
 32          FROM   TABLE(p_sessions);
 33  
 34          IF v_nb_sessions < 2 THEN
 35              RAISE_APPLICATION_ERROR(-20011,
 36                  'Un parcours compte au moins 2 sessions (' || v_nb_sessions || ' reçue(s))');
 37          END IF;
 38          IF v_nb_distinct < v_nb_sessions THEN
 39              RAISE_APPLICATION_ERROR(-20012, 'La même session apparaît deux fois dans le parcours');
 40          END IF;
 41  
 42          -- Point de retour du « tout ou rien »
 43          SAVEPOINT avant_parcours;
 44  
 45          BEGIN
 46              p_id_groupe := 'G' || TO_CHAR(seq_groupe.NEXTVAL, 'FM00000');
 47  
 48              -- Sessions prises dans l'ordre croissant de leur id : deux parcours qui
 49              -- partagent des sessions les verrouillent dans le même ordre, ce qui évite
 50              -- l'interblocage (ORA-00060) entre eux.
 51              FOR s IN (SELECT column_value AS id_session FROM TABLE(p_sessions) ORDER BY 1) LOOP
 52  
 53                  -- Verrou sur la ligne de la session (correction de l'anomalie de
 54                  -- concurrence) : une autre transaction qui veut des places dans cette
 55                  -- session attend ici notre COMMIT ou ROLLBACK. Le comptage qui suit voit
 56                  -- donc toutes les places déjà validées par les autres.
 57                  BEGIN
 58                      SELECT capacite INTO v_capacite
 59                      FROM   session_cours
 60                      WHERE  id_session = s.id_session
 61                      FOR UPDATE;
 62                  EXCEPTION
 63                      WHEN NO_DATA_FOUND THEN
 64                          RAISE_APPLICATION_ERROR(-20013,
 65                              'Session ' || s.id_session || ' inexistante : parcours refusé (RG11)');
 66                  END;
 67  
 68                  -- RG15 : refus de la sur-réservation
 69                  v_restantes := places_restantes(s.id_session);
 70                  IF v_restantes < p_nb_places THEN
 71                      RAISE_APPLICATION_ERROR(-20010,
 72                          'Session ' || s.id_session || ' : ' || GREATEST(v_restantes, 0)
 73                          || ' place(s) libre(s) sur ' || v_capacite || ', ' || p_nb_places
 74                          || ' demandée(s) : parcours refusé, aucune inscription gardée (RG15)');
 75                  END IF;
 76  
 77                  -- montant et id_site sont remplis par les triggers (RG12, L3) ;
 78                  -- RG11, RG13 et RG14 sont vérifiées par les triggers à cet INSERT.
 79                  INSERT INTO inscription (id_inscription, id_etudiant, id_session, id_groupe,
 80                                           date_operation, nb_places, montant, statut)
 81                  VALUES (seq_inscription.NEXTVAL, p_id_etudiant, s.id_session, p_id_groupe,
 82                          p_date_operation, p_nb_places, NULL, 'CONFIRMEE');
 83              END LOOP;
 84  
 85          EXCEPTION
 86              WHEN OTHERS THEN
 87                  -- Tout ou rien : on défait les inscriptions déjà posées par cet appel
 88                  -- (et leurs lignes d'audit), puis on renvoie l'erreur d'origine.
 89                  ROLLBACK TO SAVEPOINT avant_parcours;
 90                  p_id_groupe := NULL;
 91                  RAISE;
 92          END;
 93      END inscrire_parcours;
 94  
 95  
 96      PROCEDURE annuler_parcours (p_id_groupe IN inscription.id_groupe%TYPE) IS
 97      BEGIN
 98          UPDATE inscription
 99          SET    statut = 'ANNULEE'
100          WHERE  id_groupe = p_id_groupe
101          AND    statut    = 'CONFIRMEE';
102  
103          IF SQL%ROWCOUNT = 0 THEN
104              RAISE_APPLICATION_ERROR(-20014,
105                  'Parcours ' || p_id_groupe || ' introuvable ou déjà annulé');
106          END IF;
107      END annuler_parcours;
108  
109  END pkg_parcours;
110  /

Elément Package Body PKG_PARCOURS compilé

