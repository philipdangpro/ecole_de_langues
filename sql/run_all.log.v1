SQL> 
SQL> COMMENT ON COLUMN inscription.id_site IS 'Dénormalisation assumée (L3) : copie de SESSION_COURS.id_campus, tenue par fk_inscription_session_site et trg_inscription_site.';

Comment créé(e).

SQL> 
SQL> -- Remplit id_site à chaque nouvelle inscription ou changement de session.
SQL> -- Une valeur fournie par l'appelant est ignorée : c'est toujours le site de la session.
SQL> CREATE OR REPLACE TRIGGER trg_inscription_site
  2  BEFORE INSERT OR UPDATE OF id_session, id_site ON inscription
  3  FOR EACH ROW
  4  BEGIN
  5      SELECT id_campus INTO :NEW.id_site
  6      FROM   session_cours
  7      WHERE  id_session = :NEW.id_session;
  8  EXCEPTION
  9      WHEN NO_DATA_FOUND THEN
 10          RAISE_APPLICATION_ERROR(-20001,
 11              'Session ' || :NEW.id_session || ' inexistante : inscription refusée (RG11)');
 12  END;
 13  /

