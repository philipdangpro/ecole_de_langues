SQL> -- Résultat attendu : 2 droits SELECT (un par rôle), 2 politiques actives
SQL> @@10_distribution.sql
SQL> -- =====================================================================
SQL> -- 10_distribution.sql
SQL> -- Livrable : L6 · Distribution
SQL> -- Responsable : Baptiste (avec Claude Code)
SQL> -- Attendu  : fragmentation par site (schémas, db links, vues globales)
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- Prérequis : installation_system.sql relancé en system (comptes site_bordeaux,
SQL> -- site_tours, site_angers, créés pour le L6).
SQL> --
SQL> -- Architecture (explications : docs/L6_distribution/L6_distribution.md) :
SQL> --   - langues = le SIÈGE. Il garde le catalogue de répartition, les liens vers les
SQL> --     sites, les vues globales et les procédures réparties.
SQL> --   - site_bordeaux, site_tours, site_angers = la base locale de chaque SITE. Dans la
SQL> --     réalité, trois serveurs ; ici trois schémas de la même base (le kit n'a qu'une
SQL> --     instance Oracle). Seule la chaîne USING des liens changerait sur trois serveurs.
SQL> --
SQL> -- Schéma de répartition :
SQL> --   SESSION_COURS  fragmentation horizontale primaire : id_campus = site
SQL> --   INSCRIPTION    fragmentation horizontale DÉRIVÉE de SESSION_COURS (une inscription
SQL> --                  suit sa session), écrite simplement grâce à id_site, la colonne
SQL> --                  dénormalisée du L3 : la clé étrangère inscription -> session reste
SQL> --                  locale au site
SQL> --   ETUDIANT       fragmentation horizontale sur id_campus (site de rattachement) :
SQL> --                  une seule copie des données personnelles, dans le site qui suit l'étudiant
SQL> --   CATEGORIE      répliquée dans chaque site (6 lignes, ne change pas) : la clé
SQL> --                  étrangère session -> catégorie reste locale
SQL> --   CAMPUS, SIEGE, SITE : restent au siège (référentiel de l'organisation)
SQL> --   SESSION_REPLIQUE : copie redondante, au siège, des sessions d'Angers (partie 4 bis).
SQL> --                  Elle sert de secours quand Angers est en panne (bascule), et les
SQL> --                  conflits entre la copie et le site sont réglés par « le dernier
SQL> --                  écrivain gagne » (colonne derniere_maj), comme au Lab 5.
SQL> --
SQL> -- Les tables centrales de langues (L1 à L5) sont gardées : elles servent de référence
SQL> -- pour prouver que la fragmentation est complète, disjointe et reconstructible, et les
SQL> -- scripts des livrables précédents en ont besoin. Les nouvelles opérations réparties
SQL> -- (pkg_reparti) n'écrivent que dans les fragments.
SQL> --
SQL> -- Codes d'erreur pris par le L6 : -20020 à -20026.
SQL> -- Panne et reprise d'un site : sql/L6_panne_reprise.sql (à lancer à la main).
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- 1. Catalogue de répartition (au siège)
SQL> --    Le siège sait où est chaque fragment : c'est ce que lisent les procédures réparties,
SQL> --    qui choisissent leur lien à l'exécution. Ajouter un site = une ligne de plus ici.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE catalogue_site (
  2      id_site    NUMBER(4)          CONSTRAINT nn_catsite_id     NOT NULL,
  3      ville      VARCHAR2(60 CHAR)  CONSTRAINT nn_catsite_ville  NOT NULL,
  4      compte     VARCHAR2(30 CHAR)  CONSTRAINT nn_catsite_compte NOT NULL,
  5      nom_lien   VARCHAR2(30 CHAR)  CONSTRAINT nn_catsite_lien   NOT NULL,
  6      CONSTRAINT pk_catalogue_site  PRIMARY KEY (id_site),
  7      CONSTRAINT fk_catsite_site    FOREIGN KEY (id_site) REFERENCES site (id_campus),
  8      CONSTRAINT uq_catsite_lien    UNIQUE (nom_lien)
  9  );

