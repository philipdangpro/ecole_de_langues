SQL> INSERT INTO session_cours (id_session, libelle, id_categorie, id_campus, debut,
  2                             duree_minutes, capacite, prix_unitaire)
  3  SELECT TO_NUMBER(s.id_session), TRIM(s.libelle), c.id_categorie, TO_NUMBER(s.id_campus),
  4         TO_DATE(TRIM(s.debut), 'YYYY-MM-DD HH24:MI:SS'),
  5         TO_NUMBER(s.duree_minutes), TO_NUMBER(s.capacite),
