SQL> 
SQL> @@00_nettoyage.sql
SQL> -- =====================================================================
SQL> -- 00_nettoyage.sql
SQL> -- Livrable : tous
SQL> -- Rôle     : supprime tous les objets du schéma courant (langues) pour pouvoir
SQL> --            relancer run_all.sql de zéro, sur une base neuve comme sur une base déjà remplie.
SQL> -- Lancé par : sql/run_all.sql (ne pas changer l'ordre sans prévenir)
SQL> --
SQL> -- On parcourt le dictionnaire (USER_OBJECTS) plutôt que d'écrire une liste de DROP :
SQL> -- un objet ajouté plus tard par un autre livrable sera supprimé lui aussi, sans
SQL> -- erreur ORA-00942 si la table n'existe pas encore.
SQL> -- =====================================================================
SQL> 
SQL> BEGIN
  2      FOR o IN (
  3          SELECT object_name, object_type
  4          FROM   user_objects
  5          WHERE  object_type IN ('MATERIALIZED VIEW', 'VIEW', 'TABLE', 'SEQUENCE',
  6                                 'PACKAGE', 'PROCEDURE', 'FUNCTION', 'TYPE', 'SYNONYM',
  7                                 'DATABASE LINK')
  8          AND    object_name NOT LIKE 'BIN$%'          -- corbeille
  9          AND    object_name NOT LIKE 'ISEQ$$%'        -- séquences des colonnes IDENTITY
 10          AND    object_name NOT LIKE 'MLOG$%'         -- journaux de vues matérialisées
 11          ORDER BY DECODE(object_type, 'MATERIALIZED VIEW', 1, 'VIEW', 2, 'TABLE', 3,
 12                          'TYPE', 9, 5)
 13      ) LOOP
 14          BEGIN
 15              EXECUTE IMMEDIATE 'DROP ' || o.object_type || ' "' || o.object_name || '"'
 16                  || CASE o.object_type
 17                         WHEN 'TABLE' THEN ' CASCADE CONSTRAINTS PURGE'
 18                         WHEN 'TYPE'  THEN ' FORCE'
 19                     END;
 20          EXCEPTION
 21              -- objet déjà supprimé par un DROP précédent (ex. table d'une vue matérialisée)
 22              WHEN OTHERS THEN
 23                  IF SQLCODE NOT IN (-942, -4043, -2289, -12003) THEN RAISE; END IF;
 24          END;
 25      END LOOP;
 26  END;
 27  /
BEGIN
*
ERROR à la ligne 1:
ORA-65040: L'opération n'est pas autorisée à partir d'une base de données pluggable.
ORA-06512: à ligne 23
ORA-06512: à ligne 23
ORA-06512: à ligne 15

https://docs.oracle.com/error-help/db/ora-65040/


More Details :
https://docs.oracle.com/error-help/db/ora-65040/
https://docs.oracle.com/error-help/db/ora-06512/
SQL> 
SQL> PURGE RECYCLEBIN;

RECYCLEBIN purgé(e).



SQL> @@01_creation_tables.sql
SQL> -- =====================================================================
SQL> -- 01_creation_tables.sql
SQL> -- Livrable : L1 · Modèle
SQL> -- Rôle     : crée les 7 tables du modèle et 2 vues, avec toutes les contraintes nommées.
SQL> --            Modèle et règles de gestion (RG1 à RG16) : docs/L1_modele/L1_modele.md
SQL> --            Description colonne par colonne : docs/L1_modele/L1_schema_relationnel.md
SQL> -- Lancé par : sql/run_all.sql (après 00_nettoyage.sql)
SQL> --
SQL> -- Convention de nommage des contraintes :
SQL> --   pk_<table>             clé primaire
SQL> --   fk_<table>_<cible>     clé étrangère
SQL> --   uq_<table>_<colonnes>  unicité
SQL> --   ck_<table>_<règle>     vérification
SQL> --   nn_<table>_<colonne>   NOT NULL (nommée pour que le message d'erreur soit lisible)
SQL> --
SQL> -- Choix de types communs :
SQL> --   - VARCHAR2(n CHAR) : la longueur compte des caractères, pas des octets (« Siège »,
SQL> --     « Léo », « Zoé » prennent plus d'octets que de lettres en UTF-8).
SQL> --   - DATE pour toutes les dates : une DATE Oracle garde l'heure à la seconde près, ce qui
SQL> --     suffit (les CSV n'ont pas de fractions de seconde) et simplifie les calculs.
SQL> --   - Les index sur les clés étrangères ne sont pas créés ici : ils sont mesurés en L5.
SQL> -- =====================================================================
SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- CAMPUS et son héritage SIEGE / SITE (RG1, RG2)
SQL> -- Une table par type. Le type est recopié dans chaque sous-table et la clé étrangère
SQL> -- composite (id_campus, type_campus) empêche de mettre un campus de type SIEGE dans SITE.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE campus (
  2      id_campus    NUMBER(4)          CONSTRAINT nn_campus_id    NOT NULL,
  3      nom          VARCHAR2(60 CHAR)  CONSTRAINT nn_campus_nom   NOT NULL,
  4      ville        VARCHAR2(60 CHAR)  CONSTRAINT nn_campus_ville NOT NULL,
  5      type_campus  VARCHAR2(5 CHAR)   CONSTRAINT nn_campus_type  NOT NULL,
  6      CONSTRAINT pk_campus         PRIMARY KEY (id_campus),
  7      CONSTRAINT ck_campus_type    CHECK (type_campus IN ('SIEGE', 'SITE')),
  8      -- cible des clés étrangères composites des sous-tables
  9      CONSTRAINT uq_campus_id_type UNIQUE (id_campus, type_campus)
 10  );

Table CAMPUS créé(e).

SQL> 
SQL> CREATE TABLE siege (
  2      id_campus    NUMBER(4)                        CONSTRAINT nn_siege_id   NOT NULL,
  3      type_campus  VARCHAR2(5 CHAR) DEFAULT 'SIEGE' CONSTRAINT nn_siege_type NOT NULL,
  4      CONSTRAINT pk_siege        PRIMARY KEY (id_campus),
  5      CONSTRAINT ck_siege_type   CHECK (type_campus = 'SIEGE'),
  6      -- RG2 : type_campus vaut toujours 'SIEGE', donc l'unicité interdit un deuxième siège
  7      CONSTRAINT uq_siege_unique UNIQUE (type_campus),
  8      CONSTRAINT fk_siege_campus FOREIGN KEY (id_campus, type_campus)
  9                                 REFERENCES campus (id_campus, type_campus)
 10  );

Table SIEGE créé(e).

SQL> 
SQL> CREATE TABLE site (
  2      id_campus    NUMBER(4)                       CONSTRAINT nn_site_id    NOT NULL,
  3      type_campus  VARCHAR2(5 CHAR) DEFAULT 'SITE' CONSTRAINT nn_site_type  NOT NULL,
  4      id_siege     NUMBER(4)                       CONSTRAINT nn_site_siege NOT NULL,
  5      CONSTRAINT pk_site        PRIMARY KEY (id_campus),
  6      CONSTRAINT ck_site_type   CHECK (type_campus = 'SITE'),
  7      CONSTRAINT fk_site_campus FOREIGN KEY (id_campus, type_campus)
  8                                REFERENCES campus (id_campus, type_campus),
  9      -- RG2 : chaque site dépend du siège
 10      CONSTRAINT fk_site_siege  FOREIGN KEY (id_siege) REFERENCES siege (id_campus)
 11  );

Table SITE créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- ETUDIANT (l'usager) et le parrainage réflexif (RG3 à RG7)
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE etudiant (
  2      id_etudiant       NUMBER(8)           CONSTRAINT nn_etudiant_id     NOT NULL,
  3      nom               VARCHAR2(80 CHAR)   CONSTRAINT nn_etudiant_nom    NOT NULL,
  4      prenom            VARCHAR2(80 CHAR)   CONSTRAINT nn_etudiant_prenom NOT NULL,
  5      email             VARCHAR2(254 CHAR),                   -- RG5 : facultatif
  6      telephone         VARCHAR2(10 CHAR),                    -- texte : garde le 0 initial
  7      ville             VARCHAR2(60 CHAR),
  8      id_campus         NUMBER(4)           CONSTRAINT nn_etudiant_campus NOT NULL,
  9      date_inscription  DATE                CONSTRAINT nn_etudiant_date   NOT NULL,  -- création du compte
 10      id_parrain        NUMBER(8),                            -- RG7 : au plus un parrain
 11      CONSTRAINT pk_etudiant          PRIMARY KEY (id_etudiant),
 12      -- RG4 : une personne = un e-mail normalisé. Oracle n'indexe pas les NULL, donc
 13      -- plusieurs étudiants sans e-mail restent possibles (RG5).
 14      CONSTRAINT uq_etudiant_email    UNIQUE (email),
 15      CONSTRAINT ck_etudiant_email_norm CHECK (
 16          email IS NULL
 17          OR (email = LOWER(REPLACE(email, ' ', '')) AND INSTR(email, '@') > 1)),
 18      -- RG6
 19      CONSTRAINT ck_etudiant_telephone CHECK (
 20          telephone IS NULL OR REGEXP_LIKE(telephone, '^0[0-9]{9}$')),
 21      -- RG3 : la clé pointe vers SITE, pas vers CAMPUS : le siège ne peut pas avoir d'étudiants
 22      CONSTRAINT fk_etudiant_site     FOREIGN KEY (id_campus) REFERENCES site (id_campus),
 23      -- RG7 : association réflexive
 24      CONSTRAINT fk_etudiant_parrain  FOREIGN KEY (id_parrain) REFERENCES etudiant (id_etudiant),
 25      CONSTRAINT ck_etudiant_pas_son_parrain CHECK (id_parrain IS NULL OR id_parrain <> id_etudiant)
 26  );

Table ETUDIANT créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- CATEGORIE (la langue enseignée) et SESSION_COURS (la ressource datée) (RG8)
SQL> -- SESSION est un mot réservé d'Oracle, d'où le nom SESSION_COURS.
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE categorie (
  2      id_categorie  NUMBER(4) GENERATED BY DEFAULT AS IDENTITY CONSTRAINT nn_categorie_id NOT NULL,
  3      libelle       VARCHAR2(40 CHAR)  CONSTRAINT nn_categorie_libelle NOT NULL,
  4      CONSTRAINT pk_categorie          PRIMARY KEY (id_categorie),
  5      CONSTRAINT uq_categorie_libelle  UNIQUE (libelle),
  6      CONSTRAINT ck_categorie_libelle_net CHECK (libelle = TRIM(libelle))
  7  );

Table CATEGORIE créé(e).

SQL> 
SQL> CREATE TABLE session_cours (
  2      id_session     NUMBER(8)          CONSTRAINT nn_session_id        NOT NULL,
  3      libelle        VARCHAR2(80 CHAR)  CONSTRAINT nn_session_libelle   NOT NULL,
  4      id_categorie   NUMBER(4)          CONSTRAINT nn_session_categorie NOT NULL,
  5      id_campus      NUMBER(4)          CONSTRAINT nn_session_campus    NOT NULL,
  6      debut          DATE               CONSTRAINT nn_session_debut     NOT NULL,
  7      duree_minutes  NUMBER(3)          CONSTRAINT nn_session_duree     NOT NULL,
  8      capacite       NUMBER(3)          CONSTRAINT nn_session_capacite  NOT NULL,
  9      prix_unitaire  NUMBER(7,2)        CONSTRAINT nn_session_prix      NOT NULL,
 10      CONSTRAINT pk_session            PRIMARY KEY (id_session),
 11      CONSTRAINT fk_session_categorie  FOREIGN KEY (id_categorie) REFERENCES categorie (id_categorie),
 12      -- RG3 : une session se tient dans un site, jamais au siège
 13      CONSTRAINT fk_session_site       FOREIGN KEY (id_campus) REFERENCES site (id_campus),
 14      CONSTRAINT ck_session_duree      CHECK (duree_minutes IN (45, 60, 90, 120)),
 15      CONSTRAINT ck_session_capacite   CHECK (capacite > 0),
 16      CONSTRAINT ck_session_prix       CHECK (prix_unitaire >= 0)
 17  );

Table SESSION_COURS créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- INSCRIPTION : association porteuse entre ETUDIANT et SESSION_COURS (RG9, RG11, RG16)
SQL> -- Identifiant propre (id_inscription) : un étudiant peut avoir plusieurs inscriptions
SQL> -- à la même session (annulation puis réinscription) et l'audit (L4) vise une ligne précise.
SQL> -- Les règles qui portent sur plusieurs lignes ou plusieurs tables (RG7 date du parrain,
SQL> -- RG12 montant, RG13 doublon confirmé, RG14 date du compte, RG15 capacité, RG16 tout ou
SQL> -- rien) ne s'écrivent pas en CHECK : elles sont traitées par les triggers et le package (L4).
SQL> -- ---------------------------------------------------------------------
SQL> CREATE TABLE inscription (
  2      id_inscription  NUMBER(10)        CONSTRAINT nn_inscription_id       NOT NULL,
  3      id_etudiant     NUMBER(8)         CONSTRAINT nn_inscription_etudiant NOT NULL,
  4      id_session      NUMBER(8)         CONSTRAINT nn_inscription_session  NOT NULL,
  5      id_groupe       VARCHAR2(10 CHAR),                      -- opération groupée, sinon NULL
  6      date_operation  DATE              CONSTRAINT nn_inscription_date     NOT NULL,
  7      nb_places       NUMBER(3)         CONSTRAINT nn_inscription_places   NOT NULL,
  8      montant         NUMBER(9,2)       CONSTRAINT nn_inscription_montant  NOT NULL,
  9      statut          VARCHAR2(10 CHAR) CONSTRAINT nn_inscription_statut   NOT NULL,
 10      CONSTRAINT pk_inscription          PRIMARY KEY (id_inscription),
 11      CONSTRAINT fk_inscription_etudiant FOREIGN KEY (id_etudiant) REFERENCES etudiant (id_etudiant),
 12      -- RG11 : la session doit exister
 13      CONSTRAINT fk_inscription_session  FOREIGN KEY (id_session) REFERENCES session_cours (id_session),
 14      -- RG9
 15      CONSTRAINT ck_inscription_places   CHECK (nb_places >= 1),
 16      CONSTRAINT ck_inscription_statut   CHECK (statut IN ('CONFIRMEE', 'ANNULEE')),
 17      -- RG9 et RG11 : un montant négatif est refusé
 18      CONSTRAINT ck_inscription_montant  CHECK (montant >= 0),
 19      -- RG16 : format G + 5 chiffres (ex. G00042)
 20      CONSTRAINT ck_inscription_groupe   CHECK (id_groupe IS NULL OR REGEXP_LIKE(id_groupe, '^G[0-9]{5}$'))
 21  );

Table INSCRIPTION créé(e).

SQL> 
SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- Vues de règles de gestion
SQL> -- ---------------------------------------------------------------------
SQL> 
SQL> -- RG10 : le site d'une opération est celui de sa session (on ne le stocke pas en double
SQL> -- dans INSCRIPTION, il se déduit par jointure).
SQL> CREATE OR REPLACE VIEW v_inscription_site AS
  2  SELECT i.id_inscription, i.id_etudiant, i.id_session, i.id_groupe, i.date_operation,
  3         i.nb_places, i.montant, i.statut,
  4         s.id_campus AS id_site
  5  FROM   inscription i
  6  JOIN   session_cours s ON s.id_session = i.id_session;

View V_INSCRIPTION_SITE créé(e).

SQL> 
SQL> -- RG15 : places confirmées par session, comparées à la capacité
SQL> CREATE OR REPLACE VIEW v_session_occupation AS
  2  SELECT s.id_session, s.libelle, s.id_campus AS id_site, s.capacite,
  3         NVL(SUM(CASE WHEN i.statut = 'CONFIRMEE' THEN i.nb_places END), 0) AS places_confirmees,
  4         CASE WHEN NVL(SUM(CASE WHEN i.statut = 'CONFIRMEE' THEN i.nb_places END), 0) > s.capacite
  5              THEN 'O' ELSE 'N' END AS sur_reservee
  6  FROM   session_cours s
  7  LEFT JOIN inscription i ON i.id_session = s.id_session
  8  GROUP BY s.id_session, s.libelle, s.id_campus, s.capacite;

View V_SESSION_OCCUPATION créé(e).

